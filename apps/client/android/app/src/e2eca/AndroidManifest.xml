<!--
  Merged only into a debug build with the Gradle property bothyE2eCa=<PEM path> (brief M5-11
  Design note 6; app/build.gradle.kts): the network security config, generated under build/,
  keeps the platform default (system CAs, no clear text, as android:usesCleartextTraffic="false"
  of the main manifest, which the config replaces) and adds the run's test CA in debug-overrides.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/bothy_e2e_network_security_config" />
</manifest>
