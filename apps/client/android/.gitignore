# The Gradle wrapper (gradlew and gradle/wrapper/) is tracked, as in packages/device_key/android,
# so the instrumented tests run without the Flutter tool; the rest is generated per machine.
/.gradle
/.kotlin
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/
*.iml

# Never commit signing material.
key.properties
**/*.keystore
**/*.jks
# The Flutter tool writes the Windows wrapper script on a build; Windows builds no Android app here.
/gradlew.bat

# The Firebase configuration of an instance's build (brief M5-05): it belongs to the operator's
# build branding, never to this repository; fixtures/google-services.json is a fake for tests.
/app/google-services.json
