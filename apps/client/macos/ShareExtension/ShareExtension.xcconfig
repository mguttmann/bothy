// SPDX-License-Identifier: Apache-2.0
// Build settings of the macOS Share Extension (brief M5-06). The version comes from Flutter's
// generated settings (variables only, nothing is linked from them), name and bundle identifier
// from the build branding. The extension links only ClientKit, ClientKitShare and DeviceKeyCore,
// never Flutter (tools/ci/check_extension_links.py).
#include "../Flutter/ephemeral/Flutter-Generated.xcconfig"
#include "../Runner/Configs/Branding.xcconfig"

PRODUCT_NAME = ShareExtension
PRODUCT_BUNDLE_IDENTIFIER = $(BRANDING_BUNDLE_ID).ShareExtension
INFOPLIST_FILE = ShareExtension/Info.plist
MACOSX_DEPLOYMENT_TARGET = 12.0
SWIFT_VERSION = 5.0
SKIP_INSTALL = YES
APPLICATION_EXTENSION_API_ONLY = YES
ENABLE_HARDENED_RUNTIME = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @executable_path/../../../../Frameworks
