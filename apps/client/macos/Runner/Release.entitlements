<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- network.client: REST and gateway. network.server: the loopback listener of the OIDC
     redirect on 127.0.0.1 with a free port (docs/spec/15-client-architecture.md 8, RFC 8252).
     keychain-access-groups: the Data Protection keychain of flutter_secure_storage and the
     device keys (15 9). device.audio-input and device.microphone: voice messages (15 13); files.user-selected:
     the open and save dialogs of the attachments (brief M4-22) and the file dialog of the
     administration for the manifest of an app (11 4.1, M6-08). Push (brief M5-04):
     aps-environment (development, as Xcode writes it; the export for distribution re-signs
     with the profile's production value, docs/decisions.d/M5-04.md D-M5-04-10), the App Group and the second keychain group the app shares with its
     Notification Service Extension; the app's own group stays first, so its secrets stay out
     of the shared one. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(CLIENTKIT_APP_GROUP)</string>
	</array>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.microphone</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<string>$(CLIENTKIT_KEYCHAIN_GROUP)</string>
	</array>
</dict>
</plist>
