# Line endings: LF in the repository and in working trees, also on Windows.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.p8 binary
*.zip binary

# Generated files: collapsed in GitHub diffs, excluded from language statistics
uv.lock linguist-generated=true
package-lock.json linguist-generated=true
pubspec.lock linguist-generated=true
go.sum linguist-generated=true
docs/**/*.svg linguist-generated=true
design/build/** linguist-generated=true

# Append-only registries: a local rebase, cherry-pick or merge keeps the lines both sides
# appended (docs/DECISIONS.md PL/27). GitHub's merge ignores this driver.
CHANGELOG.md merge=union
docs/DECISIONS.md merge=union
migrations.sha256 merge=union
tools/docs/language-allow.txt merge=union
