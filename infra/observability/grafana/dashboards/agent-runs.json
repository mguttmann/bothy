{
  "uid": "bothy-agent-runs",
  "title": "Bothy / Agent runs",
  "description": "Runs (live box), adapters, invocation checks and estimated cost. Values for cost are estimates until reconciled.",
  "tags": [
    "bothy"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(target_info{job=\"bothy/bothy-server\"}, deployment_environment_name)",
          "refId": "env"
        },
        "definition": "label_values(target_info{job=\"bothy/bothy-server\"}, deployment_environment_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {},
        "sort": 1
      },
      {
        "name": "agent",
        "label": "Agent",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(bothy_run_active{job=\"bothy/bothy-server\"}, bothy_agent_handle)",
          "refId": "agent"
        },
        "definition": "label_values(bothy_run_active{job=\"bothy/bothy-server\"}, bothy_agent_handle)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {},
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Bothy",
      "type": "dashboards",
      "tags": [
        "bothy"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Runs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active runs",
      "description": "Runs in queued, running or waiting_input.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bothy_run_state) (bothy_run_active{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\"})",
          "legendFormat": "{{bothy_run_state}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Runs started within 7.5 s",
      "description": "Share of runs leaving queued that started within 7.5 s (SLO: bothy-agents run-start).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(bothy_run_start_latency_seconds_bucket{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\",bothy_outcome=\"started\",le=\"7.5\"}[$__range])) / sum(rate(bothy_run_start_latency_seconds_count{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\",bothy_outcome!=\"cancelled\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Estimated cost (range)",
      "description": "Sum of run cost in the selected range per currency, organization and personal mode together. Estimates until reconciled; not a bill.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bothy_currency) (increase(bothy_run_cost_total{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\"}[$__range]))",
          "legendFormat": "{{bothy_currency}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Runs finished by state",
      "description": "Runs per minute that ended in completed, failed or cancelled.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bothy_run_state) (rate(bothy_run_finished_total{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\"}[$__rate_interval])) * 60",
          "legendFormat": "{{bothy_run_state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failures by reason",
      "description": "Failed runs per minute by state_reason (e.g. billing_mode_mismatch, access_revoked, stale, adapter_error).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bothy_reason) (rate(bothy_run_finished_total{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\",bothy_run_state=\"failed\"}[$__rate_interval])) * 60",
          "legendFormat": "{{bothy_reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Start latency p95 by agent",
      "description": "p95 from queued to running.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, bothy_agent_handle) (rate(bothy_run_start_latency_seconds_bucket{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\"}[$__rate_interval])))",
          "legendFormat": "{{bothy_agent_handle}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Turn duration by agent",
      "description": "p50 and p95 from running to the end state, completed runs only.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, bothy_agent_handle) (rate(bothy_run_duration_seconds_bucket{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\",bothy_run_state=\"completed\"}[$__rate_interval])))",
          "legendFormat": "p50 {{bothy_agent_handle}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, bothy_agent_handle) (rate(bothy_run_duration_seconds_bucket{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\",bothy_run_state=\"completed\"}[$__rate_interval])))",
          "legendFormat": "p95 {{bothy_agent_handle}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Steps by kind",
      "description": "Run steps per minute (tool calls, status lines, subagents, workflows, background jobs).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bothy_step_kind) (rate(bothy_run_steps_total{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\"}[$__rate_interval])) * 60",
          "legendFormat": "{{bothy_step_kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Tokens by type",
      "description": "Tokens per minute reported by adapters, by token type.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bothy_token_type) (rate(bothy_run_tokens_total{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\"}[$__rate_interval])) * 60",
          "legendFormat": "{{bothy_token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Adapters and policy",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Consumer lag",
      "description": "Unacknowledged durable events per agent consumer (head_seq - acked_seq).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (bothy_agent_handle) (bothy_agent_consumer_lag{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\"})",
          "legendFormat": "{{bothy_agent_handle}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Heartbeat age",
      "description": "Seconds since the last adapter heartbeat.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (bothy_agent_handle) (bothy_agent_heartbeat_age_seconds{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\"})",
          "legendFormat": "{{bothy_agent_handle}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Invocation denials",
      "description": "Invocations refused before delivery (I2) by reason.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bothy_reason) (rate(bothy_agent_invocation_denied_total{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\"}[$__rate_interval]))",
          "legendFormat": "{{bothy_reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Billing mode mismatches",
      "description": "Adapter-reported mode differs from the policy (I3). Every value above zero needs a look.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bothy_agent_handle) (increase(bothy_agent_billing_mode_mismatch_total{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\"}[$__rate_interval]))",
          "legendFormat": "{{bothy_agent_handle}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Reported billing mode differs",
      "description": "Seconds since the configured and the heartbeat-reported billing mode began to differ, 0 without a difference. The alarm BothyBillingModeMismatch fires above billing.mismatch_alert_after.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (bothy_agent_handle) (bothy_agent_billing_mode_mismatch_age_seconds{job=\"bothy/bothy-server\",deployment_environment_name=~\"$env\",bothy_agent_handle=~\"$agent\"})",
          "legendFormat": "{{bothy_agent_handle}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
