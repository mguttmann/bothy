{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/bothy/demo.schema.json",
  "title": "Data set of the demo instance",
  "description": "docs/spec/16-operations.md 16.3. bothy setup demo validates demo.yaml against this schema before it connects anywhere; references between the sections (people, agents, spaces, channels) are checked by the command on top.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "values", "people", "prices", "agents", "spaces", "host", "prompts", "live"],
  "properties": {
    "version": {"const": 1},
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_prompts", "pace", "agent_wait", "host_wait", "agent_token_ttl", "worker_steps", "step_interval", "watcher_interval", "tokens_in", "tokens_out"],
      "properties": {
        "warmup_prompts": {"type": "integer", "minimum": 0, "maximum": 500},
        "pace": {"$ref": "#/$defs/duration"},
        "agent_wait": {"$ref": "#/$defs/duration"},
        "host_wait": {"$ref": "#/$defs/duration"},
        "agent_token_ttl": {"$ref": "#/$defs/duration"},
        "worker_steps": {"type": "integer", "minimum": 1, "maximum": 20},
        "step_interval": {"$ref": "#/$defs/duration"},
        "watcher_interval": {"$ref": "#/$defs/duration"},
        "tokens_in": {"type": "integer", "minimum": 0},
        "tokens_out": {"type": "integer", "minimum": 0}
      }
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle", "display_name", "locale", "time_zone"],
        "properties": {
          "handle": {"$ref": "#/$defs/handle"},
          "display_name": {"$ref": "#/$defs/label"},
          "owner": {"type": "boolean"},
          "locale": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
          "time_zone": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      }
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model", "unit", "price_micros", "currency"],
        "properties": {
          "provider": {"$ref": "#/$defs/handle"},
          "model": {"$ref": "#/$defs/handle"},
          "unit": {"enum": ["input_mtok", "output_mtok", "cache_read_mtok", "cache_write_mtok", "cache_write_1h_mtok", "request"]},
          "price_micros": {"type": "integer", "minimum": 0},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle", "display_name", "description", "role", "provider", "model"],
        "properties": {
          "handle": {"$ref": "#/$defs/handle"},
          "display_name": {"$ref": "#/$defs/label"},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "role": {"enum": ["worker", "reviewer", "watcher"]},
          "provider": {"$ref": "#/$defs/handle"},
          "model": {"$ref": "#/$defs/handle"}
        }
      }
    },
    "spaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "members", "channels"],
        "properties": {
          "name": {"$ref": "#/$defs/label"},
          "icon": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "color": {"type": "string", "pattern": "^[a-z]+$"},
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level", "capabilities"],
              "oneOf": [{"required": ["person"]}, {"required": ["agent"]}],
              "properties": {
                "person": {"$ref": "#/$defs/handle"},
                "agent": {"$ref": "#/$defs/handle"},
                "level": {"enum": ["read", "write", "trigger"]},
                "capabilities": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"enum": ["upload", "approve_actions", "export", "manage"]}
                }
              }
            }
          },
          "channels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "threads"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
                "kind": {"enum": ["text", "forum"]},
                "topic": {"type": "string", "maxLength": 500},
                "operator": {"$ref": "#/$defs/handle"},
                "threads": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["title", "messages"],
                    "properties": {
                      "title": {"$ref": "#/$defs/label"},
                      "messages": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["author", "text"],
                          "properties": {
                            "author": {"$ref": "#/$defs/handle"},
                            "text": {"$ref": "#/$defs/text"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reason", "session_users"],
      "properties": {
        "name": {"$ref": "#/$defs/label"},
        "reason": {"$ref": "#/$defs/label"},
        "session_users": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["person", "os_user"],
            "properties": {
              "person": {"$ref": "#/$defs/handle"},
              "os_user": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$"}
            }
          }
        }
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["space", "channel", "title", "texts"],
        "properties": {
          "space": {"$ref": "#/$defs/label"},
          "channel": {"type": "string"},
          "title": {"$ref": "#/$defs/label"},
          "texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
        }
      }
    },
    "live": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["space", "channel", "title", "person", "text"],
        "properties": {
          "space": {"$ref": "#/$defs/label"},
          "channel": {"type": "string"},
          "title": {"$ref": "#/$defs/label"},
          "person": {"$ref": "#/$defs/handle"},
          "text": {"$ref": "#/$defs/text"}
        }
      }
    }
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 200},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "duration": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"}
  }
}
