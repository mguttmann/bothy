# Compose interpolation variables of the smoke test (brief M1-73); not server keys, no secrets.
# infra/compose/smoke.sh always passes this file with --env-file, so the .env of a real
# installation is never read. BOTHY_REGISTRY and BOTHY_VERSION only satisfy the checks of the
# installation file; every service from the server image is overridden by the test overlay.
COMPOSE_PROFILES=direct,smoke
BOTHY_REGISTRY=registry.invalid
BOTHY_VERSION=smoke
BOTHY_PUBLIC_URL=https://chat.example.com
BOTHY_ENVIRONMENT=staging
BOTHY_OTEL_EXPORTER=none
BOTHY_OTEL_EXPORTER_2=none
BOTHY_TRACE_SAMPLE_PERCENT=100
BOTHY_OTEL_METRIC_EXPORT_INTERVAL_MS=1000
