#
# TEST ONLY: the TLS front of the instance origin https://chat.example.com:8443 in the stack of
# the terminal conformance suite (brief M2-48 Design note 3, services/server/test/terminal). It
# stands where the operator's edge stands in the profile direct. The suite renders this template
# into its temporary folder (TERMSUITE_FRONT_DIR): the timeouts come from the profile of the stack,
# for everything else terminal.host_heartbeat_interval times terminal.host_heartbeat_miss_limit,
# for the stream paths terminal.idle_timeout plus terminal.idle_grace plus that window, so the
# front never cuts a quiet stream before the server ends it. routing.conf (one of routing-single.conf, routing-hash.conf, routing-split.conf)
# names the three upstreams; the suite switches the mode by replacing it and running nginx -s
# reload.
worker_processes 1;
error_log /dev/stderr crit;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    access_log off;
    server_tokens off;
    client_max_body_size 0;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        "" close;
    }

    include /etc/termsuite-front/routing.conf;

    server {
        listen 8443 ssl;
        server_name chat.example.com;
        ssl_certificate /etc/termsuite-front/front.crt;
        ssl_certificate_key /etc/termsuite-front/front.key;
        ssl_protocols TLSv1.2 TLSv1.3;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;

        # The device stream of a terminal session.
        location ~ ^/api/v1/terminal/sessions/[^/]+/stream$ {
            proxy_pass http://termsuite_device;
            proxy_read_timeout {{.StreamSeconds}}s;
            proxy_send_timeout {{.StreamSeconds}}s;
        }

        # The data connection of the host service for one session.
        location ~ ^/api/v1/hosts/sessions/[^/]+/stream$ {
            proxy_pass http://termsuite_hostdata;
            proxy_read_timeout {{.StreamSeconds}}s;
            proxy_send_timeout {{.StreamSeconds}}s;
        }

        # Everything else: the API, the control connection of the host service and the gateway.
        location / {
            proxy_pass http://termsuite_rest;
            proxy_read_timeout {{.OtherSeconds}}s;
            proxy_send_timeout {{.OtherSeconds}}s;
        }
    }
}
