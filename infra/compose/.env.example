# Template for infra/compose/.env. Copy it, replace the placeholders, never commit it.
# Placeholders and defaults only. Secrets do NOT belong here; they go as files into ./secrets
# (see README.md). Only exception: TS_AUTHKEY for the first Tailscale login.
# Meaning of every variable: docs/operations/configuration.md, section "Compose variables".

# --- Selection --------------------------------------------------------------------------------
# Exactly one of direct or tailscale; add scan, s3, observability as needed.
COMPOSE_PROFILES=direct,scan

# --- Image version and origin ----------------------------------------------------------------
# Registry path in lower case, e.g. ghcr.io/<owner>. OWNER is a placeholder; in the bundle of a
# product release, make release-build sets the owner of the repository
# (docs/spec/18-release.md, section 2.1).
BOTHY_REGISTRY=ghcr.io/OWNER
# Release version of the server (SemVer without "v"), e.g. 1.0.0. Never "latest".
# The product release pins it here: make release-prep COMPONENT=bothy SERVER_VERSION=<version>.
# make release-build refuses the placeholder (docs/spec/18-release.md, section 2.1).
BOTHY_VERSION=0.0.0-placeholder

# --- Instance ---------------------------------------------------------------------------------
BOTHY_ENVIRONMENT=prod
# Public base URL under which the apps reach the server.
BOTHY_PUBLIC_URL=https://chat.example.com

# --- Network and ports (127.0.0.1 only) -------------------------------------------------------
BOTHY_HTTP_PUBLISH_PORT=8090
# Peers whose plain HTTP and forwarding headers the server accepts (profile direct).
# In profile direct the server sees the gateway of the Compose network as peer, not the reverse
# proxy. Enter that address as /32 (docker network inspect <project>_default, field Gateway),
# otherwise the server rejects every request. The default accepts loopback only. install.sh
# writes the gateway here in profile direct (docs/spec/16-operations.md, section 3.1).
BOTHY_TRUSTED_PROXIES=127.0.0.1/32,::1/128
BOTHY_OTLP_PUBLISH_PORT=4318
BOTHY_PROMETHEUS_PUBLISH_PORT=9090
BOTHY_ALERTMANAGER_PUBLISH_PORT=9093
BOTHY_GRAFANA_PUBLISH_PORT=3300

# --- Tailscale (profile tailscale only) -------------------------------------------------------
TS_HOSTNAME=bothy
# One-time key for the first login; clear it again after the first start.
TS_AUTHKEY=
# renovate: datasource=docker depName=tailscale/tailscale
BOTHY_TAILSCALE_VERSION=v1.102.5

# --- Files ------------------------------------------------------------------------------------
# fs (volume `files`) or s3 (profile s3 or an external S3 service).
BOTHY_STORAGE_DRIVER=fs
BOTHY_S3_ENDPOINT=http://seaweedfs:8333
BOTHY_S3_BUCKET=bothy-files
BOTHY_CLAMD_ADDRESS=tcp://clamav:3310

# --- Database and backup ----------------------------------------------------------------------
BOTHY_PG_SHM_SIZE=256m
BOTHY_PG_ARCHIVE_TIMEOUT=60s
# Off-site backup target, e.g. s3:https://s3.example.com/bothy-backup or sftp:backup@backup.example.com:/bothy
# Empty means: local repository only (no protection against losing the host).
BOTHY_BACKUP_OFFSITE_TARGET=

# --- Telemetry ------------------------------------------------------------------------------
# Overlay names from infra/otel/exporters: none, local, newrelic, grafana, datadog, azure-monitor, sentry
BOTHY_OTEL_EXPORTER=none
BOTHY_OTEL_EXPORTER_2=none
BOTHY_OTEL_METRIC_EXPORT_INTERVAL_MS=15000
BOTHY_TRACE_SAMPLE_PERCENT=10
BOTHY_TRACE_SLOW_THRESHOLD_MS=2000
BOTHY_OTEL_MEMORY_LIMIT_PERCENT=80
# Only for overlays with an external target (values without secrets):
NEW_RELIC_OTLP_ENDPOINT=https://otlp.eu01.nr-data.net
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-REGION.grafana.net/otlp
GRAFANA_INSTANCE_ID=
DD_SITE=datadoghq.eu
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_MONITOR_TRACES_ENDPOINT=
AZURE_MONITOR_METRICS_ENDPOINT=
AZURE_MONITOR_LOGS_ENDPOINT=
SENTRY_OTLP_TRACES_ENDPOINT=
SENTRY_OTLP_LOGS_ENDPOINT=

# --- Local observability stack (profile observability) ---------------------------------------
BOTHY_PROMETHEUS_RETENTION=30d
BOTHY_LOKI_RETENTION=14d
BOTHY_TEMPO_RETENTION=168h

# --- Images of the helper services (updates via Renovate per ADR 0041, set up by M1-04) -------
# The validators of otelcol-contrib, Prometheus, Alertmanager, Loki and Tempo in
# tools/bin/tools.lock.json follow these versions (make tools-lock, check tool-versions).
# renovate: datasource=docker depName=otel/opentelemetry-collector-contrib
BOTHY_OTELCOL_VERSION=0.162.0
# renovate: datasource=docker depName=clamav/clamav-debian
BOTHY_CLAMAV_VERSION=1.5.4
# renovate: datasource=docker depName=chrislusf/seaweedfs
BOTHY_SEAWEEDFS_VERSION=4.48
# renovate: datasource=docker depName=prom/prometheus
BOTHY_PROMETHEUS_VERSION=v3.15.0
# renovate: datasource=docker depName=prom/alertmanager
BOTHY_ALERTMANAGER_VERSION=v0.34.1
# renovate: datasource=docker depName=grafana/loki
BOTHY_LOKI_VERSION=3.7.8
# renovate: datasource=docker depName=grafana/tempo
BOTHY_TEMPO_VERSION=3.1.0
# renovate: datasource=docker depName=grafana/grafana
BOTHY_GRAFANA_VERSION=13.2.3

# --- Resources and logs ----------------------------------------------------------------------
BOTHY_CLAMAV_MEMORY_LIMIT=4g
BOTHY_LOG_MAX_SIZE=20m
BOTHY_LOG_MAX_FILE=5
