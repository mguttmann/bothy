# Vorlage für infra/compose/.env. Kopieren, Platzhalter ersetzen, nie committen.
# Nur Platzhalter und Standardwerte. Geheimnisse gehören NICHT hierher, sondern als Dateien nach
# ./secrets (siehe README.md). Einzige Ausnahme: TS_AUTHKEY für die erste Tailscale-Anmeldung.
# Bedeutung aller Variablen: docs/operations/configuration.md, Abschnitt "Compose-Variablen".

# --- Auswahl ---------------------------------------------------------------------------------
# Genau eines von direct oder tailscale; dazu nach Bedarf scan, s3, observability.
COMPOSE_PROFILES=direct,scan

# --- Version und Herkunft der Images ---------------------------------------------------------
# Registry-Pfad in Kleinbuchstaben, z. B. ghcr.io/<owner>. OWNER ist ein Platzhalter.
BOTHY_REGISTRY=ghcr.io/OWNER
# Release-Version des Servers (SemVer ohne "v"), z. B. 1.0.0. Nie "latest".
BOTHY_VERSION=0.0.0-placeholder

# --- Instanz ---------------------------------------------------------------------------------
BOTHY_ENVIRONMENT=prod
# Öffentliche Basis-URL, unter der Apps den Server erreichen.
BOTHY_PUBLIC_URL=https://chat.example.com

# --- Netz und Ports (nur 127.0.0.1) ----------------------------------------------------------
BOTHY_HTTP_PUBLISH_PORT=8090
BOTHY_OTLP_PUBLISH_PORT=4318
BOTHY_PROMETHEUS_PUBLISH_PORT=9090
BOTHY_ALERTMANAGER_PUBLISH_PORT=9093
BOTHY_GRAFANA_PUBLISH_PORT=3300

# --- Tailscale (nur Profil tailscale) --------------------------------------------------------
TS_HOSTNAME=bothy
# Einmal-Schlüssel für die erste Anmeldung; nach dem ersten Start wieder leeren.
TS_AUTHKEY=
BOTHY_TAILSCALE_VERSION=v1.102.5

# --- Dateien ---------------------------------------------------------------------------------
# fs (Volume `files`) oder s3 (Profil s3 oder externer S3-Dienst).
BOTHY_STORAGE_DRIVER=fs
BOTHY_S3_ENDPOINT=http://seaweedfs:8333
BOTHY_S3_BUCKET=bothy-files
BOTHY_CLAMD_ADDRESS=tcp://clamav:3310

# --- Datenbank und Sicherung -----------------------------------------------------------------
BOTHY_PG_SHM_SIZE=256m
BOTHY_PG_ARCHIVE_TIMEOUT=60s
# Off-site-Ziel der Sicherung, z. B. s3:https://s3.example.com/bothy-backup oder sftp:backup@backup.example.com:/bothy
# Leer heißt: nur lokales Repository (kein Schutz gegen Verlust des Hosts).
BOTHY_BACKUP_OFFSITE_TARGET=

# --- Telemetrie ------------------------------------------------------------------------------
# Overlay-Namen aus infra/otel/exporters: none, local, newrelic, grafana, datadog, azure-monitor, sentry
BOTHY_OTEL_EXPORTER=none
BOTHY_OTEL_EXPORTER_2=none
BOTHY_OTEL_METRIC_EXPORT_INTERVAL_MS=15000
BOTHY_TRACE_SAMPLE_PERCENT=10
BOTHY_TRACE_SLOW_THRESHOLD_MS=2000
BOTHY_OTEL_MEMORY_LIMIT_PERCENT=80
# Nur für Overlays mit externem Ziel (Werte ohne Geheimnis):
NEW_RELIC_OTLP_ENDPOINT=https://otlp.eu01.nr-data.net
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-REGION.grafana.net/otlp
GRAFANA_INSTANCE_ID=
DD_SITE=datadoghq.eu
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_MONITOR_TRACES_ENDPOINT=
AZURE_MONITOR_METRICS_ENDPOINT=
AZURE_MONITOR_LOGS_ENDPOINT=
SENTRY_OTLP_TRACES_ENDPOINT=
SENTRY_OTLP_LOGS_ENDPOINT=

# --- Lokaler Observability-Stack (Profil observability) ---------------------------------------
BOTHY_PROMETHEUS_RETENTION=30d
BOTHY_LOKI_RETENTION=14d
BOTHY_TEMPO_RETENTION=168h

# --- Images der Hilfsdienste (Renovate hält sie aktuell) --------------------------------------
BOTHY_OTELCOL_VERSION=0.162.0
BOTHY_CLAMAV_VERSION=1.5.4
BOTHY_SEAWEEDFS_VERSION=4.48
BOTHY_PROMETHEUS_VERSION=v3.15.0
BOTHY_ALERTMANAGER_VERSION=v0.34.1
BOTHY_LOKI_VERSION=3.7.8
BOTHY_TEMPO_VERSION=3.1.0
BOTHY_GRAFANA_VERSION=13.2.3

# --- Ressourcen und Logs ---------------------------------------------------------------------
BOTHY_CLAMAV_MEMORY_LIMIT=4g
BOTHY_LOG_MAX_SIZE=20m
BOTHY_LOG_MAX_FILE=5
