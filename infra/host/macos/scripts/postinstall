#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# After the bothy-host .pkg is installed (brief M7-23, docs/spec/16-operations.md 4.4): launchd
# loads every plist in /Library/LaunchDaemons at the next start of the machine, so until
# "bothy-host install" has created the service user the job of the host service stays disabled,
# and the package starts nothing. install enables it before it loads the LaunchDaemon. An upgrade
# of an installed host (the service user exists) changes nothing; the running service keeps its
# old binary until "bothy-host restart".
set -eu
if ! /usr/bin/id bothy-host >/dev/null 2>&1; then
  /bin/launchctl disable system/bothy-host
fi
exit 0
