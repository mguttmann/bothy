<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!--
  MSI of the host service bothy-host (brief M7-23, docs/spec/16-operations.md 4.4). It installs the
  binary into %ProgramFiles%\bothy-host (owned by the trusted owners, read and execute for users)
  and registers the Windows service bothy-host stopped, with the start type demand: it never starts
  a service and never pairs. "bothy-host install" then creates the session users and their helper
  services, sets the host service to start automatically with its recovery actions and DACL, and
  starts it. An uninstall stops and removes the service and the binary; the state folder, the
  configuration file and the helper services, which install created, stay.

  Built by tools/distribution/hostdist.py (WiX Toolset, version pinned there):
    wix build bothy-host.wxs -arch x64 -d ProductVersion=<X.Y.Z> -d BinaryPath=<bothy-host.exe>
  The Arguments and the account equal the definition of bothy-host install
  (services/host/internal/install, TestMSIServiceEqualsInstall).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="bothy-host" Manufacturer="bothy-host" Version="$(var.ProductVersion)"
           UpgradeCode="ed080718-7edd-4d5e-b649-bc513d51689b" Scope="perMachine" Compressed="yes">
    <!-- The same version may be installed again: a stable X.Y.Z follows its X.Y.Z-beta.N with the
         same MSI version (docs/spec/18-release.md 5 rule 2). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of bothy-host is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="bothy-host">
        <Component Id="HostBinary" Bitness="always64">
          <File Id="HostExe" Name="bothy-host.exe" Source="$(var.BinaryPath)" KeyPath="yes" />
          <ServiceInstall Id="HostService" Name="bothy-host" DisplayName="bothy-host service"
                          Description="Host service of the terminal (bothy-host install completes the setup)"
                          Type="ownProcess" Start="demand" ErrorControl="normal"
                          Account="NT SERVICE\bothy-host"
                          Arguments="run --config &quot;[ProgramFiles64Folder]bothy-host\config.yaml&quot;" Vital="yes" />
          <ServiceControl Id="HostServiceControl" Name="bothy-host" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main" Title="bothy-host">
      <ComponentRef Id="HostBinary" />
    </Feature>
    <!-- The computer helper (docs/spec/27-computer-use.md 9.2 and 9.3, docs/decisions.d/CU-02.md
         D-CU-02-10), only in the package built on the owner's machine with
         -d HelperPath=<bothy-computer-helper.exe> -d HelperScript=<set-computer-use.ps1>
         -d HelperStartScript=<start-computer-helper.ps1> (hostdist.py helper-package-windows); the release MSI carries none of it (D-CU-01-29).
         The feature is off unless selected (ADDLOCAL=ComputerHelper): the helper goes to
         %ProgramFiles%\bothy-host next to bothy-host.exe (uiAccess needs a protected folder; D-CU-03-7), its start entry
         to the Run key of the machine, set-computer-use.ps1 sets host_service.computer_use
         in the configuration file as the system account, and start-computer-helper.ps1 starts the
         helper in the session of the person at the console. An uninstall removes helper and start
         entry; the key stays in the configuration like every other key. -->
    <?ifdef HelperPath?>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="HelperExe" Bitness="always64">
        <File Id="HelperExeFile" Name="bothy-computer-helper.exe" Source="$(var.HelperPath)" KeyPath="yes" />
      </Component>
      <Component Id="HelperConfigScript" Bitness="always64">
        <File Id="HelperConfigScriptFile" Name="set-computer-use.ps1" Source="$(var.HelperScript)" KeyPath="yes" />
      </Component>
      <Component Id="HelperStartScript" Bitness="always64">
        <File Id="HelperStartScriptFile" Name="start-computer-helper.ps1" Source="$(var.HelperStartScript)" KeyPath="yes" />
      </Component>
      <Component Id="HelperStartEntry" Bitness="always64">
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="bothy-computer-helper" Type="string"
                       Value="&quot;[INSTALLFOLDER]bothy-computer-helper.exe&quot;" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="ComputerHelper" Title="Computer helper" Level="1000" AllowAbsent="yes"
             Description="Lets an agent of the owner control this desktop (sets host_service.computer_use).">
      <ComponentRef Id="HelperExe" />
      <ComponentRef Id="HelperConfigScript" />
      <ComponentRef Id="HelperStartScript" />
      <ComponentRef Id="HelperStartEntry" />
    </Feature>
    <CustomAction Id="SetComputerUse" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]set-computer-use.ps1&quot; -Config &quot;[INSTALLFOLDER]config.yaml&quot;" />
    <!-- StartComputerHelper starts the helper at once in the session of the person at the console
         (start-computer-helper.ps1), so it reaches the host service without a new login; it never
         fails the install. -->
    <CustomAction Id="StartComputerHelper" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]start-computer-helper.ps1&quot; -Helper &quot;[INSTALLFOLDER]bothy-computer-helper.exe&quot;" />
    <InstallExecuteSequence>
      <Custom Action="SetComputerUse" After="InstallFiles" Condition="&amp;ComputerHelper=3" />
      <Custom Action="StartComputerHelper" After="SetComputerUse" Condition="&amp;ComputerHelper=3" />
    </InstallExecuteSequence>
    <?endif?>
  </Package>
</Wix>
