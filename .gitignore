# Local configuration that must never be committed
.denylist-path
# Review reports of the pre-push gate (stay local; the pull request names commit and verdict)
.review/
.env
.env.*
!.env.example
tools/sonarqube/.env
# Supplied secrets and decrypted escrow bundles of the Compose stack (docs/spec/16-operations.md 5.3)
infra/compose/secrets/

# Tool caches and build outputs of the repository gates
.cache/
site/
dist/

# Python and uv
.venv/
# setuptools metadata of the editable SDK path dependency of plugins/claude-code-runner (M2-34)
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml

# Node
node_modules/

# Go
coverage.out

# Flutter and Dart (design/build/ is generated but committed on purpose)
.dart_tool/
/build/
# Dart API pages, generated by `make docs` (tools/docs/dart_api_docs.py) and never tracked
docs/api/dart/
apps/**/build/
packages/**/build/
apps/**/coverage/
packages/**/coverage/
# Platform folder of the visualization harness, made by its performance test
# (packages/bothy_viz/harness/tool/perf_macos.sh; docs/DECISIONS.md D-M6-11-6)
packages/bothy_viz/harness/macos/
# Coverage output of the SDK test runners (Vitest writes coverage/lcov.info)
sdk/**/coverage/
# Coverage output of the TypeScript apps under plugins/ (M2-49)
plugins/*/coverage/
# Build output and typedoc reference of the TypeScript SDK (`npm run build`, `npm run docs`)
sdk/typescript/dist/
sdk/typescript/build/

# Editors, operating systems and local agent state
.DS_Store
.idea/
.vscode/
*.swp
.claude/worktrees/
.claude/settings.local.json
**/test/goldens/failures/
