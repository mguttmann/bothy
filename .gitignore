# Local configuration that must never be committed
.denylist-path
.env
.env.*
!.env.example
tools/sonarqube/.env
# Supplied secrets and decrypted escrow bundles of the Compose stack (docs/spec/16-betrieb.md 5.3)
infra/compose/secrets/

# Tool caches and build outputs of the repository gates
.cache/
site/
dist/

# Python and uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml

# Node
node_modules/

# Go
coverage.out

# Flutter and Dart (design/build/ is generated but committed on purpose)
.dart_tool/
apps/**/build/
packages/**/build/
apps/**/coverage/
packages/**/coverage/
# Coverage output of the SDK test runners (Vitest writes coverage/lcov.info)
sdk/**/coverage/

# Editors, operating systems and local agent state
.DS_Store
.idea/
.vscode/
*.swp
.claude/worktrees/
.claude/settings.local.json
