flowchart LR
    subgraph sources["Sources"]
        server["Server api and worker (OTel Go SDK)"]
        backupd["bothy-backupd"]
        adapter["Agent adapter (SDK, gen_ai spans)"]
        runtime["Agent runtime (own OTel data, optional)"]
        pgrecv["PostgreSQL (receiver in the Collector)"]
    end

    subgraph collector["OpenTelemetry Collector (base)"]
        recv["OTLP receiver"]
        guard["memory_limiter"]
        scrub["transform/scrub: delete contents"]
        allow["redaction: allowlist and HMAC pseudonyms"]
        tail["tail_sampling: errors, slow, ratio"]
        fwd["forward connectors"]
    end

    subgraph overlays["Overlays (0 to 2)"]
        local["local: Prometheus, Loki, Tempo"]
        ext["newrelic, grafana, datadog, azure-monitor, sentry"]
        nop["none: discard"]
    end

    audit[("audit_events in PostgreSQL: never via the Collector")]
    stats[("Admin statistics: own tables")]
    sentryapps["Sentry (app crashes directly from the apps)"]

    server --> recv
    backupd --> recv
    adapter --> recv
    runtime -. "metadata only" .-> recv
    pgrecv --> guard
    recv --> guard --> scrub --> allow --> tail --> fwd
    fwd --> local
    fwd --> ext
    fwd --> nop
    server -- "same transaction" --> audit
    server --> stats
    server -. "no path" .-x sentryapps
