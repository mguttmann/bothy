%% Systemgrenzen-Diagramm zum Bedrohungsmodell (docs/security/threat-model.md)
%% Rendern: mermaid-cli 11 (siehe docs/security/threat-model.md, Abschnitt 2)
flowchart LR
    subgraph Z1["Zone 1: Endgeräte (nicht vertrauenswürdig)"]
        APP["Native Apps<br/>iOS, Android, macOS, Windows<br/>Geräteschlüssel, lokaler Cache"]
        CON["Admin-Konsole<br/>Browser, Flutter Web"]
    end

    subgraph Z2["Zone 2: Netzrand"]
        PRX["Reverse-Proxy mit TLS<br/>z. B. Caddy oder tailscale serve"]
    end

    subgraph Z3["Zone 3: Server-Host (vertrauenswürdig)"]
        SRV["Server<br/>Rollen api und worker<br/>authz, identity, Gateway"]
        DB[("PostgreSQL<br/>Inhalte, Ereignis-Log,<br/>Audit-Log")]
        OBJ[("Objektspeicher<br/>Dateien")]
        AV["Virenscanner<br/>Unix-Socket"]
        OTC["OTel Collector"]
        SP["Secret-Provider<br/>Signierschlüssel, Pepper"]
    end

    subgraph Z4["Zone 4: Agenten (halb vertrauenswürdig)"]
        ADP["Agenten-Adapter<br/>z. B. Hermes Agent, Dev-Runner"]
        RT["Laufzeit mit Werkzeugen<br/>Werkzeugklasse chat, scoped, host"]
        DEV["Dev-Umgebung je Person<br/>VM"]
    end

    subgraph Z5["Zone 5: Integrationen (nicht vertrauenswürdig)"]
        APPS["Apps und Plugins"]
        EXT["Externe Systeme<br/>Eingangs-Webhooks"]
    end

    subgraph Z6["Zone 6: Externe Dienste"]
        IDP["Identitätsanbieter OIDC"]
        PUSH["APNs, FCM, WNS"]
        LLM["LLM-Anbieter"]
        TEL["Telemetrie-Backends"]
    end

    subgraph Z7["Zone 7: Betrieb und Lieferkette"]
        OPS["Owner am Host<br/>CLI, Sicherungen"]
        CI["Repository, CI, Registry"]
    end

    APP -- "TB1: HTTPS mit DPoP, WSS" --> PRX
    CON -- "TB1: HTTPS, Cookie (BFF)" --> PRX
    PRX -- "TB2: HTTP über Loopback" --> SRV
    SRV -- "TB3: SQL" --> DB
    SRV -- "TB3: S3-API oder Dateisystem" --> OBJ
    SRV -- "TB3: INSTREAM" --> AV
    SRV -. "liest beim Start" .-> SP
    SRV -- "OTLP ohne Inhalte" --> OTC
    OTC -- "TB7" --> TEL
    ADP -- "TB4: API-Token, WSS, Aufruf-Marke" --> PRX
    ADP --> RT
    RT -- "TB5: Prompts und Inhalte" --> LLM
    RT -- "TB9: Lauf in Umgebung der Person" --> DEV
    APPS -- "TB6: API-Token, WSS" --> PRX
    SRV -- "TB6: signierte Webhooks an erlaubte Ziele" --> APPS
    EXT -- "TB6: geheime URL" --> PRX
    APP -- "TB1: Systembrowser" --> IDP
    SRV -- "TB7: Code-Tausch, JWKS" --> IDP
    SRV -- "TB7: nur IDs" --> PUSH
    PUSH -- "TB7" --> APP
    OPS -- "TB8: Verwaltungsrolle" --> DB
    CI -- "TB8: signierte Artefakte" --> OPS
