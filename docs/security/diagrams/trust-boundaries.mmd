%% System boundary diagram for the threat model (docs/security/threat-model.md)
%% Render: mermaid-cli 11 (see docs/security/threat-model.md, section 2)
flowchart LR
    subgraph Z1["Zone 1: End devices (untrusted)"]
        APP["Native apps<br/>iOS, Android, macOS, Windows<br/>device key, local cache"]
        CON["Admin console<br/>browser, Flutter Web"]
    end

    subgraph Z2["Zone 2: Network edge"]
        PRX["Reverse proxy with TLS<br/>for example Caddy or tailscale serve"]
    end

    subgraph Z3["Zone 3: Server host (trusted)"]
        SRV["Server<br/>roles api and worker<br/>authz, identity, gateway"]
        DB[("PostgreSQL<br/>contents, event log,<br/>audit log")]
        OBJ[("Object storage<br/>files")]
        AV["Virus scanner<br/>Unix socket"]
        OTC["OTel Collector"]
        SP["Secret provider<br/>signing keys, pepper"]
    end

    subgraph Z4["Zone 4: Agents (semi-trusted)"]
        ADP["Agent adapters<br/>for example Hermes Agent, dev runner"]
        RT["Runtime with tools<br/>tool class chat, scoped, host"]
        DEV["Dev environment per person<br/>VM"]
    end

    subgraph Z8["Zone 8: Connected hosts (semi-trusted)"]
        HOSTD["Host service bothy-host<br/>own user without admin"]
        PTY["PTY: shell or coding agent"]
    end

    subgraph Z5["Zone 5: Integrations (untrusted)"]
        APPS["Apps and plugins"]
        EXT["External systems<br/>incoming webhooks"]
    end

    subgraph Z6["Zone 6: External services"]
        IDP["Identity provider OIDC"]
        PUSH["APNs, FCM, WNS"]
        LLM["LLM providers"]
        TEL["Telemetry backends"]
    end

    subgraph Z7["Zone 7: Operations and supply chain"]
        OPS["Owner on the host<br/>CLI, backups"]
        CI["Repository, CI, registry"]
    end

    APP -- "TB1: HTTPS with DPoP, WSS" --> PRX
    CON -- "TB1: HTTPS, cookie (BFF)" --> PRX
    PRX -- "TB2: HTTP over loopback" --> SRV
    SRV -- "TB3: SQL" --> DB
    SRV -- "TB3: S3 API or file system" --> OBJ
    SRV -- "TB3: INSTREAM" --> AV
    SRV -. "reads at startup" .-> SP
    SRV -- "OTLP without contents" --> OTC
    OTC -- "TB7" --> TEL
    ADP -- "TB4: API token, WSS, invocation token" --> PRX
    ADP --> RT
    RT -- "TB5: prompts and contents" --> LLM
    RT -- "TB9: run in the environment of the person" --> DEV
    APPS -- "TB6: API token, WSS" --> PRX
    SRV -- "TB6: signed webhooks to allowed targets" --> APPS
    EXT -- "TB6: secret URL" --> PRX
    APP -- "TB1: system browser" --> IDP
    SRV -- "TB7: code exchange, JWKS" --> IDP
    SRV -- "TB7: IDs only" --> PUSH
    PUSH -- "TB7" --> APP
    OPS -- "TB8: admin role" --> DB
    CI -- "TB8: signed artifacts" --> OPS
    APP -- "TB10: Noise stream end-to-end" --> PRX
    HOSTD -- "TB10: WSS outbound, login key" --> PRX
    HOSTD --> PTY
