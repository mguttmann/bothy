%% ERD Teil 9: Module importer, status und stats. Quelle: 03-datenmodell.md, 4.11 (Import),
%% 4.12 (Status) und 4.15. backup_runs und stats_minutes haben bewusst keine Fremdschlüssel.
%% Reine Protokoll-Spalten (created_by, updated_by und ähnliche) zeigen auf principals(id) und
%% sind nicht als Beziehung gezeichnet.
%% Tabellen anderer Module nur mit Schlüssel.
erDiagram
  direction LR
  import_sources {
    uuid id PK
    text kind "discord, archive"
    text state "draft, running, paused, completed, failed"
  }
  import_items {
    uuid id PK
    uuid source_id FK
    text origin_key "UK mit source_id"
    text item_kind
    text state "pending, posted, skipped, failed"
  }
  status_components {
    uuid id PK
    text state
    uuid agent_id FK
  }
  status_incidents {
    uuid id PK
    text state
  }
  status_incident_updates {
    uuid id PK
    uuid incident_id FK
  }
  status_incident_components {
    uuid incident_id PK, FK
    uuid component_id PK, FK
  }
  backup_runs {
    uuid id PK
    text kind "pg_full, pg_diff, logical, objects, restore_test"
    text state "running, succeeded, failed"
    timestamptz finished_at
  }
  stats_minutes {
    timestamptz bucket_start "UK mit allen Dimensionen, Partition je Tag"
    text metric
    uuid channel_id "ohne FK"
    uuid agent_id "ohne FK"
    text dimension
    text currency "nur bei cost"
    bigint count
    bigint sum
    bigint good
  }
  agents {
    uuid principal_id PK
  }

  import_sources ||--o{ import_items : "enthält"
  agents |o--o{ status_components : "überwacht"
  status_incidents ||--o{ status_incident_updates : "Verlauf"
  status_incidents ||--o{ status_incident_components : "betrifft"
  status_components ||--o{ status_incident_components : "betroffen"
