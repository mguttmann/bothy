  subgraph edge["Edge: connections, consumers, cross-cutting"]
    gateway["<b>gateway</b><br/>WebSocket, fan-out, focus, typing"]:::top
    notify["<b>notify</b><br/>Notification, push"]:::top
    apps["<b>apps</b><br/>Apps, webhooks in and out"]:::top
    stats["<b>stats</b><br/>Statistics, own measurement,<br/>live frame"]:::top
    privacy["<b>privacy</b><br/>Privacy requests"]:::top
    importer["<b>importer</b><br/>Import"]:::top
    search["<b>search</b><br/>Full-text search"]:::top
  end

  subgraph core["Domain core"]
    sync["<b>sync</b><br/>Event log, catch-up, snapshot,<br/>read state, drafts, settings"]:::mid
    runs["<b>runs</b><br/>Triggering, runs, live box,<br/>components, interactions"]:::mid
    messaging["<b>messaging</b><br/>Messages, reactions, pins"]:::mid
    status["<b>status</b><br/>Status page"]:::mid
    agents["<b>agents</b><br/>Agents, sessions, commands,<br/>consumer cursors"]:::mid
