    terminal["<b>terminal</b><br/>Hosts, terminal sessions,<br/>terminal session tokens, relay"]:::mid
  end

  subgraph foundation["Foundation"]
    identity["<b>identity</b><br/>Principals, devices, sessions, tokens"]:::base
    authz["<b>authz</b><br/>authorize, groups, grants, I1, I6"]:::base
    audit["<b>audit</b><br/>Audit log"]:::base
    billing["<b>billing</b><br/>Costs, prices"]:::base
    instance["<b>instance</b><br/>Settings, switches,<br/>keys, counters"]:::base
  end

  kernel["<b>internal/kernel</b><br/>Cross-cutting ports: authorize, txn, eventlog,<br/>auditing, idempotency, actor, personaldata,<br/>measure, presence"]:::shared
