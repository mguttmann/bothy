%% ERD part 3: modules agents and apps. Source: 03-data-model.md, 4.4, 4.5 (agent_sessions) and 4.11.
%% dev_environments belongs to the dev environment milestone (21-dev-isolation.md).
%% Pure log columns (created_by, updated_by, granted_by, revoked_by and similar) point to
%% principals(id) and are not drawn as a relationship.
%% Tables of other modules only with their key.
erDiagram
  direction LR
  agents {
    uuid principal_id PK, FK
    text adapter_kind
    text billing_mode "personal, organization"
    uuid credential_holder_id FK "required exactly for personal"
    text reported_billing_mode
    text tool_class "chat, scoped, host"
    text reported_tool_class
    text reported_runtime_state
    bigint version
  }
  agent_consumer_cursors {
    uuid agent_id PK, FK
    text consumer_name PK
    bigint acked_seq
    uuid holder_session_id "fencing"
  }
  dev_environments {
    uuid id PK
    uuid user_id FK
    uuid runner_agent_id FK
    text billing_mode "organization"
    text state "provisioning, verifying, ready, suspended, retired"
    bigint version
  }
  commands {
    uuid id PK
    uuid owner_principal_id FK "agent or app"
    text name
    text scope_kind "instance, space, channel"
    uuid scope_space_id FK
    uuid scope_channel_id FK
    boolean control
  }
  agent_sessions {
    uuid id PK
    uuid thread_id FK
    uuid agent_id FK
    uuid dev_environment_id FK
    text external_session_ref
    boolean is_current
    text end_reason
    bigint version
  }
  apps {
    uuid principal_id PK, FK
    text slug UK
    jsonb manifest
    text manifest_version
  }
  app_installations {
    uuid id PK
    uuid app_id FK
    text[] granted_scopes
    text state "active, suspended, uninstalled"
  }
  webhook_subscriptions {
    uuid id PK
    uuid app_installation_id FK "exactly one of the two"
    uuid agent_id FK "webhook as agent transport"
    text signing_key_kid FK
    text state "active, paused, disabled"
    bigint last_delivered_seq
  }
  webhook_deliveries {
    uuid id PK
    uuid subscription_id FK
    bigint event_seq
    text status "pending, succeeded, failed, dead"
  }
  incoming_webhooks {
    uuid id PK
    uuid app_id FK
    uuid channel_id FK
    uuid thread_id FK
    bytea token_hash UK
  }
  principals {
    uuid id PK
  }
  users {
    uuid principal_id PK
  }
  spaces {
    uuid id PK
  }
  channels {
    uuid id PK
  }
  threads {
    uuid id PK
  }
  server_signing_keys {
    text kid PK
  }

  principals ||--o| agents : "is agent"
  users |o--o{ agents : "credential_holder"
  users ||--o{ dev_environments : "belongs to"
  agents ||--o{ dev_environments : "runner"
  dev_environments |o--o{ agent_sessions : "runs in"
  agents |o--o{ webhook_subscriptions : "subscribes"
  agents ||--o{ agent_consumer_cursors : "reads"
  principals ||--o{ commands : "registers"
  spaces |o--o{ commands : "scope"
  channels |o--o{ commands : "scope"
  threads ||--o{ agent_sessions : "sessions"
  agents ||--o{ agent_sessions : "conducts"
  principals ||--o| apps : "is app"
  apps ||--o{ app_installations : "installed"
  app_installations |o--o{ webhook_subscriptions : "subscribes"
  server_signing_keys ||--o{ webhook_subscriptions : "signs"
  webhook_subscriptions ||--o{ webhook_deliveries : "attempts"
  apps ||--o{ incoming_webhooks : "writes as"
  channels ||--o{ incoming_webhooks : "target"
  threads |o--o{ incoming_webhooks : "fixed thread"
