%% ERD Teil 5: Module runs und billing. Quelle: 03-datenmodell.md, 4.8 und 4.9.
%% Reine Protokoll-Spalten (created_by, updated_by, granted_by, revoked_by und ähnliche) zeigen auf
%% principals(id) und sind nicht als Beziehung gezeichnet.
%% Tabellen anderer Module nur mit Schlüssel.
erDiagram
  direction LR
  runs {
    uuid id PK
    uuid thread_id FK
    uuid agent_id FK
    uuid agent_session_id FK
    text trigger_kind "message, command, interaction"
    uuid triggering_message_id FK
    uuid triggering_command_id FK
    uuid triggering_interaction_id FK
    uuid triggered_by FK "Mensch, der ausgelöst hat"
    text state "queued, running, waiting_input, completed, failed, cancelled"
    bigint version
    text billing_mode_expected
    text billing_mode_used
    uuid invocation_jti UK
    uuid started_jti
    uuid renewed_from_jti
    uuid dev_environment_id FK
  }
  run_steps {
    uuid id PK
    uuid run_id FK
    integer ordinal "UK mit run_id"
    uuid parent_step_id FK
    text kind "tool_call, status, subagent, workflow, background_job"
  }
  run_followups {
    uuid run_id PK, FK
    uuid message_id PK, FK "UK"
    text state "queued, delivered, absorbed, deferred, discarded"
  }
  message_components {
    uuid id PK
    uuid message_id FK
    text custom_id "UK mit message_id"
    text type "button, select, form"
    uuid run_id FK
    text state "active, used, expired, disabled"
  }
  interactions {
    uuid id PK
    uuid component_id FK
    uuid message_id FK
    uuid principal_id FK
    uuid client_interaction_id "UK mit principal_id"
    text state
  }
  price_table {
    uuid id PK
    text provider
    text model
    text unit
    timestamptz valid_from
  }
  cost_entries {
    uuid id PK
    uuid run_id FK
    uuid agent_id FK
    uuid thread_id FK
    uuid channel_id FK
    uuid space_id FK
    uuid agent_session_id FK
    text billing_mode
    bigint amount_micros
    text source "adapter_reported, computed, unpriced, reconciled"
    boolean is_estimate
    uuid supersedes_id FK
  }
  threads {
    uuid id PK
  }
  channels {
    uuid id PK
  }
  spaces {
    uuid id PK
  }
  agents {
    uuid principal_id PK
  }
  agent_sessions {
    uuid id PK
  }
  messages {
    uuid id PK
  }
  principals {
    uuid id PK
  }
  commands {
    uuid id PK
  }
  dev_environments {
    uuid id PK
  }

