---
config:
  layout: elk
---
%% Ereignis-Pfad: Schreib-Transaktion -> event_log -> Fan-out -> Verbindungen, Agenten-Verbraucher,
%% Worker-Verbraucher -> Push und Webhooks. Beschreibung: 02-architektur.md, Abschnitt 11.
flowchart TB
  classDef step fill:#136f69,stroke:#063b38,color:#fbfeff
  classDef store fill:#12659d,stroke:#0b4d79,color:#fbfeff
  classDef check fill:#eddc59,stroke:#8d7716,color:#291f02
  classDef ext fill:#59696c,stroke:#24363a,color:#fbfeff

  subgraph tx["Schreib-Transaktion (Unit of Work, READ COMMITTED)"]
    t1["1 permission_version sperren<br/>(nur bei Rechte-Änderung)"]:::step
    t2["2 Domänenzeilen schreiben<br/>(nur das besitzende Modul)"]:::step
    t3["3 In-Tx-Abonnenten<br/>(z. B. runs auf MessagePosted)"]:::step
    t4["4 Vor-Commit, nur bei Rechte-Änderung:<br/>authz prüft I1, berechnet access.changed"]:::check
    t5["5 sync: event_seq sperren,<br/>event_log schreiben, pg_notify"]:::step
    t6["6 audit: audit_seq sperren,<br/>Hash-Kette, COMMIT"]:::step
    t1 --> t2 --> t3 --> t4 --> t5 --> t6
  end

  log[("event_log<br/>commit-geordnete seq")]:::store
  t5 --> log

  subgraph apinode["jeder api-Knoten"]
    tail["Log-Tail (sync)<br/>ein Leser je Prozess,<br/>Wecksignal NOTIFY oder Poll"]:::step
    rc["Rechte-Cache (authz)<br/>folgt access.changed in Log-Reihenfolge"]:::check
    hub["Hub (gateway)<br/>Index Kanal und Prinzipal<br/>zu Verbindungen"]:::step
    conn["Client-Verbindung<br/>authorize je Empfänger,<br/>Ausgangs-Warteschlange begrenzt"]:::check
    agentc["Agenten-Verbraucher<br/>Cursor acked_seq, In-Flight-Fenster,<br/>vor Aufruf: agent.invoke, I2, Marke"]:::check
    tail --> rc --> hub
    hub --> conn
    hub --> agentc
  end

  subgraph workernode["worker"]
    cons["Ereignis-Verbraucher mit Cursor<br/>(push, webhooks), SKIP LOCKED"]:::step
    jobs["River-Jobs je Empfänger<br/>bzw. je Zustellung"]:::step
    pushj["notify.push_send<br/>authorize push.deliver"]:::check
    hookj["webhook_out.deliver<br/>Signatur, Backoff"]:::check
    cons --> jobs
    jobs --> pushj
    jobs --> hookj
  end

  log -->|"NOTIFY nur seq"| tail
  log -->|"NOTIFY nur seq"| cons
  conn --> apps["Apps und Konsole"]:::ext
  agentc --> adapter["Agenten-Adapter"]:::ext
  pushj --> pushsvc["APNs, FCM"]:::ext
  hookj --> integr["Integrationen"]:::ext
