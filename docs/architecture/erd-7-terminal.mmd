%% ERD part 7: module terminal. Source: 03-data-model.md, 4.14; 24-terminal.md.
%% Pure log columns (created_by, confirmed_by, llm_credentials_declared_by, revoked_by, closed_by) point to
%% principals(id) and are not drawn as a relationship.
%% Tables of other modules only with their key. Grants on hosts are in part 2 (grants).
erDiagram
  hosts {
    uuid id PK
    text state "pairing, confirming, active, disabled, retired"
    text platform "macos, linux, windows"
    uuid assigned_user_id FK "host assignee (SR10)"
    uuid dev_environment_id FK "dev environment milestone"
    text llm_credentials "none, personal, organization"
    uuid credential_holder_id FK "required exactly for personal (I6)"
    boolean declared_server_host
    bytea noise_public_key "X25519"
    text auth_jkt "Ed25519"
    text key_fingerprint
    integer key_generation
    jsonb reported_session_users "reported names (T12, T13)"
    bigint version
  }
  host_session_users {
    uuid id PK
    uuid host_id FK
    uuid user_id FK
    text os_user "unique per host, also after the end (T12)"
    timestamptz revoked_at
  }
  terminal_sessions {
    uuid id PK
    uuid host_id FK
    uuid user_id FK
    uuid host_session_user_id FK "together with host_id and user_id"
    uuid opened_by_device_id FK
    uuid device_id FK
    uuid auth_session_id FK
    text profile
    text state "opening, active, detached, closed"
    uuid token_jti
    text close_reason
  }
  users {
    uuid principal_id PK
  }
  devices {
    uuid id PK
  }
  auth_sessions {
    uuid id PK
  }
  dev_environments {
    uuid id PK
  }

  users |o--o{ hosts : "assignee"
  users |o--o{ hosts : "holder of the LLM login"
  dev_environments |o--o| hosts : "is"
  hosts ||--o{ terminal_sessions : "conducts"
  hosts ||--o{ host_session_users : "has"
  users ||--o{ host_session_users : "owns"
  host_session_users ||--o{ terminal_sessions : "runs as"
  users ||--o{ terminal_sessions : "opens"
  devices ||--o{ terminal_sessions : "opened by"
  devices ||--o{ terminal_sessions : "connected"
  auth_sessions ||--o{ terminal_sessions : "allows"
