%% ERD Teil 6: Modul sync. Quelle: 03-datenmodell.md, 4.10. event_log und
%% event_consumer_cursors haben bewusst keine Fremdschlüssel.
%% Reine Protokoll-Spalten (created_by, updated_by und ähnliche) zeigen auf principals(id) und
%% sind nicht als Beziehung gezeichnet.
%% Tabellen anderer Module nur mit Schlüssel. Benachrichtigung (notify) steht in Teil 10.
erDiagram
  direction LR
  event_log {
    bigint seq PK "commit-geordnet, lückenlos"
    uuid id
    text type
    uuid space_id
    uuid channel_id
    uuid thread_id
    text resource_kind
    uuid resource_id
    uuid audience_principal_id
    text receive_action
    jsonb payload
    uuid correlation_id
    text trace_context
    bigint permission_version
  }
  event_consumer_cursors {
    text name PK "push, webhooks"
    bigint last_seq
  }
  idempotency_keys {
    uuid principal_id PK, FK
    uuid key PK
    text state "in_progress, completed"
    timestamptz expires_at
  }
  read_states {
    uuid user_id PK, FK
    uuid thread_id PK, FK
    uuid channel_id FK
    bigint last_read_seq
    uuid updated_by_device_id FK
  }
  drafts {
    uuid id PK
    uuid user_id FK
    uuid thread_id FK
    uuid channel_id FK
    uuid reply_to_message_id FK
    uuid updated_by_device_id FK
    bigint version
  }
  user_settings {
    uuid user_id PK, FK
    text key PK
    uuid updated_by_device_id FK
    bigint version
  }
  principals {
    uuid id PK
  }
  users {
    uuid principal_id PK
  }
  devices {
    uuid id PK
  }
  threads {
    uuid id PK
  }
  channels {
    uuid id PK
  }
  messages {
    uuid id PK
  }

  principals ||--o{ idempotency_keys : "nutzt"
  users ||--o{ read_states : "hat"
  threads ||--o{ read_states : "gelesen"
  channels ||--o{ read_states : "Kopie"
  devices |o--o{ read_states : "zuletzt von"
  users ||--o{ drafts : "schreibt"
  threads |o--o{ drafts : "für"
  channels ||--o{ drafts : "in"
  messages |o--o{ drafts : "Antwort auf"
  devices |o--o{ drafts : "zuletzt von"
  users ||--o{ user_settings : "hat"
  devices |o--o{ user_settings : "zuletzt von"
