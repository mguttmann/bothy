%% ERD part 6: module sync. Source: 03-data-model.md, 4.10. event_log and
%% event_consumer_cursors deliberately have no foreign keys.
%% Pure log columns (created_by, updated_by and similar) point to principals(id) and
%% are not drawn as a relationship.
%% Tables of other modules only with their key. Notification (notify) is in part 10.
erDiagram
  direction LR
  event_log {
    bigint seq PK "commit-ordered, gapless"
    uuid id
    text type
    uuid space_id
    uuid channel_id
    uuid thread_id
    text resource_kind
    uuid resource_id
    uuid audience_principal_id
    text receive_action
    jsonb payload
    uuid correlation_id
    text trace_context
    bigint permission_version
  }
  event_consumer_cursors {
    text name PK "push, webhooks"
    bigint last_seq
  }
  idempotency_keys {
    uuid principal_id PK, FK
    uuid key PK
    text state "in_progress, completed"
    timestamptz expires_at
  }
  read_states {
    uuid user_id PK, FK
    uuid thread_id PK, FK
    uuid channel_id FK
    bigint last_read_seq
    uuid updated_by_device_id FK
  }
  drafts {
    uuid id PK
    uuid user_id FK
    uuid thread_id FK
    uuid channel_id FK
    uuid reply_to_message_id FK
    uuid updated_by_device_id FK
    bigint version
  }
  user_settings {
    uuid user_id PK, FK
    text key PK
    uuid updated_by_device_id FK
    bigint version
  }
  principals {
    uuid id PK
  }
  users {
    uuid principal_id PK
  }
  devices {
    uuid id PK
  }
  threads {
    uuid id PK
  }
  channels {
    uuid id PK
  }
  messages {
    uuid id PK
  }

  principals ||--o{ idempotency_keys : "uses"
  users ||--o{ read_states : "has"
  threads ||--o{ read_states : "read"
  channels ||--o{ read_states : "copy"
  devices |o--o{ read_states : "last by"
  users ||--o{ drafts : "writes"
  threads |o--o{ drafts : "for"
  channels ||--o{ drafts : "in"
  messages |o--o{ drafts : "reply to"
  devices |o--o{ drafts : "last by"
  users ||--o{ user_settings : "has"
  devices |o--o{ user_settings : "last by"
