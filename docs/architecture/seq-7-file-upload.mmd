%% File upload with malware scan and thumbnail. Domain details: 12-files.md.
sequenceDiagram
  autonumber
  participant A as App Alex
  box api node
    participant F as files
    participant MSG as messaging
    participant HUB as gateway hub
  end
  participant DB as PostgreSQL
  participant OBJ as Object storage
  box worker
    participant SJ as Job files.scan
    participant TJ as Job files.thumbnail
  end
  participant AV as ClamAV clamd
  participant S as App Sam

  A->>F: POST upload session (channel, size, name, declared type)
  F->>F: authorize(Alex, file.upload, channel): write and upload, size at most file.max_upload_bytes
  F->>DB: INSERT files (upload_state pending, random object_key)
  alt driver S3 with presigned URL
    F-->>A: short-lived PUT URL with checksum header
    A->>OBJ: PUT bytes
  else driver file system or upload through the server
    F-->>A: upload target on the server
    A->>F: PUT bytes (streamed, size limited)
    F->>OBJ: write, SHA-256 while passing through
  end
  A->>F: POST complete upload
  F->>DB: session completed, job files.scan (round 0) in the same transaction, no event
  F-->>A: 200 file (pending, being checked)
  A->>MSG: POST message with file_id (message.create, plus upload)
  MSG->>F: bind attachment to the message in the same channel
  MSG-->>A: 201, display "being checked"
  SJ->>AV: PING over the Unix socket (file.scan.mode required)
  SJ->>OBJ: one read pass: parts in order (file system) or the object, join into the object
  SJ->>SJ: size and SHA-256 against the declaration, type from the first file.sniff_bytes
  SJ->>AV: INSTREAM in chunks of the same stream, end with a zero-length chunk (mode required)
  alt size, SHA-256 or detected type wrong
    SJ->>DB: upload_state failed with its reason, file.updated, FileFinalized
    SJ->>OBJ: delete object and parts
  else file.scan.mode off, no clamd call
    SJ->>DB: upload_state complete, scan_status skipped, mime_type, file.updated, FileFinalized
    SJ->>OBJ: delete parts
  else stream: OK
    AV-->>SJ: OK
    SJ->>DB: upload_state complete, scan_status clean, mime_type, scanned_at, file.updated, FileFinalized
    SJ->>OBJ: delete parts
    TJ->>OBJ: read, decode, re-encode (metadata removed), write variants (M3-06)
    TJ->>DB: file_thumbnails, file.updated
  else FOUND
    AV-->>SJ: FOUND
    SJ->>DB: scan_status infected, audit entry, file.updated, FileFinalized
    SJ->>OBJ: delete object and parts
  else clamd not reachable
    SJ->>DB: next files.scan with growing delay up to file.scan.retry_backoff_cap, stays pending (fail closed)
  end
  HUB-->>S: dispatch file.updated
  S->>F: GET thumbnail (file.read, only when clean or skipped)
