%% ERD Teil 6: Module sync, notify, importer, audit, privacy, status. Quelle: 03-datenmodell.md,
%% 4.10, 4.11 (Import) und 4.12. event_log, event_consumer_cursors, audit_events und backup_runs
%% haben bewusst keine Fremdschlüssel.
%% Reine Protokoll-Spalten (created_by, updated_by, granted_by, revoked_by und ähnliche) zeigen auf
%% principals(id) und sind nicht als Beziehung gezeichnet.
%% Tabellen anderer Module nur mit Schlüssel.
erDiagram
  event_log {
    bigint seq PK "commit-geordnet, lückenlos"
    uuid id
    text type
    uuid space_id
    uuid channel_id
    uuid thread_id
    text resource_kind
    uuid resource_id
    uuid audience_principal_id
    text receive_action
    jsonb payload
    uuid correlation_id
    text trace_context
    bigint permission_version
  }
  event_consumer_cursors {
    text name PK "push, webhooks"
    bigint last_seq
  }
  idempotency_keys {
    uuid principal_id PK, FK
    uuid key PK
    text state "in_progress, completed"
    timestamptz expires_at
  }
  read_states {
    uuid user_id PK, FK
    uuid thread_id PK, FK
    uuid channel_id FK
    bigint last_read_seq
    uuid updated_by_device_id FK
  }
  drafts {
    uuid id PK
    uuid user_id FK
    uuid thread_id FK
    uuid channel_id FK
    uuid reply_to_message_id FK
    uuid updated_by_device_id FK
    bigint version
  }
  user_settings {
    uuid user_id PK, FK
    text key PK
    uuid updated_by_device_id FK
    bigint version
  }
  notification_preferences {
    uuid user_id PK, FK
    text target_kind PK "space, channel, thread"
    uuid target_id PK "polymorph, ohne FK"
    text level "all, mentions, mute"
  }
  quiet_hours {
    uuid id PK
    uuid user_id FK
    smallint weekdays
  }
  push_registrations {
    uuid id PK
    uuid user_id FK
    uuid device_id FK
    uuid auth_session_id FK
    text provider "apns, fcm, unifiedpush, wns"
    text token "UK mit provider"
    bytea preview_token_hash UK
    timestamptz disabled_at
    text disabled_reason
  }
  import_sources {
    uuid id PK
    text kind "discord, archive"
    text state "draft, running, paused, completed, failed"
  }
  import_items {
    uuid id PK
    uuid source_id FK
    text origin_key "UK mit source_id"
    text item_kind
    text state "pending, posted, skipped, failed"
  }
  audit_events {
    bigint seq PK
    uuid id UK
    text action
    text decision "allow, deny, error"
    bytea prev_hash
    bytea hash UK
  }
  audit_checkpoints {
    bigint seq PK "letzte erfasste audit_events.seq"
    bytea hash
    text kid FK
    timestamptz exported_at
  }
  gdpr_requests {
    uuid id PK
    uuid subject_user_id FK
    text kind "export, deletion, rectification"
    text state
    uuid result_file_id FK
  }
  status_components {
    uuid id PK
    text state
    uuid agent_id FK
  }
  status_incidents {
    uuid id PK
    text state
  }
  status_incident_updates {
    uuid id PK
    uuid incident_id FK
  }
  status_incident_components {
    uuid incident_id PK, FK
    uuid component_id PK, FK
  }
  backup_runs {
    uuid id PK
    text kind "pg_full, pg_diff, logical, objects, restore_test"
    text state "running, succeeded, failed"
    timestamptz finished_at
  }
  principals {
    uuid id PK
  }
  users {
    uuid principal_id PK
  }
  devices {
    uuid id PK
  }
  threads {
    uuid id PK
  }
  channels {
    uuid id PK
  }
  messages {
    uuid id PK
  }
  files {
    uuid id PK
  }
  agents {
    uuid principal_id PK
  }
  auth_sessions {
    uuid id PK
  }
  server_signing_keys {
    text kid PK
  }

  principals ||--o{ idempotency_keys : "nutzt"
  users ||--o{ read_states : "hat"
  threads ||--o{ read_states : "gelesen"
  channels ||--o{ read_states : "Kopie"
  devices |o--o{ read_states : "zuletzt von"
  users ||--o{ drafts : "schreibt"
  threads |o--o{ drafts : "für"
  channels ||--o{ drafts : "in"
  messages |o--o{ drafts : "Antwort auf"
  devices |o--o{ drafts : "zuletzt von"
  users ||--o{ user_settings : "hat"
  devices |o--o{ user_settings : "zuletzt von"
  users ||--o{ notification_preferences : "hat"
  users ||--o{ quiet_hours : "hat"
  users ||--o{ push_registrations : "hat"
  devices ||--o{ push_registrations : "empfängt"
  auth_sessions ||--o{ push_registrations : "Sitzung"
  server_signing_keys ||--o{ audit_checkpoints : "signiert"
  import_sources ||--o{ import_items : "enthält"
  users ||--o{ gdpr_requests : "betroffen"
  files |o--o{ gdpr_requests : "Exportpaket"
  agents |o--o{ status_components : "überwacht"
  status_incidents ||--o{ status_incident_updates : "Verlauf"
  status_incidents ||--o{ status_incident_components : "betrifft"
  status_components ||--o{ status_incident_components : "betroffen"
