%% ERD Teil 1: Module instance und identity. Quelle: 03-datenmodell.md, 4.1 und 4.2.
%% Gezeigt: Schlüssel, Fremdschlüssel und Spalten mit Zustand. Reine Protokoll-Spalten (created_by,
%% updated_by, granted_by, revoked_by und ähnliche) zeigen auf principals(id) und sind nicht als
%% Beziehung gezeichnet. Tabellen anderer Module nur mit Schlüssel.
erDiagram
  instance {
    smallint id PK "CHECK id = 1"
    uuid instance_id UK
    timestamptz setup_completed_at
    text min_server_version
    uuid sync_epoch "Zeitlinie des Ereignis-Logs"
  }
  instance_settings {
    text key PK
    jsonb value
    bigint version
  }
  server_signing_keys {
    text kid PK
    text purpose "access_token, invocation, webhook_out, audit_checkpoint"
    text state "next, active, retiring, retired"
  }
  feature_flags {
    text key PK
    boolean enabled
    jsonb rollout
  }
  sequence_counters {
    text name PK "event_seq, audit_seq, permission_version"
    bigint value
  }
  principals {
    uuid id PK
    text kind "user, agent, app"
    text status "pending, active, disabled, deleted"
    text handle UK
    uuid avatar_file_id FK
  }
  users {
    uuid principal_id PK, FK
    text email UK
    text time_zone
  }
  owners {
    uuid id PK
    uuid user_id FK
    timestamptz revoked_at
  }
  identity_providers {
    uuid id PK
    text kind "oidc, trusted_header, local"
    boolean allow_provisioning
  }
  user_identities {
    uuid id PK
    uuid user_id FK
    uuid provider_id FK
    text subject
  }
  passkey_credentials {
    uuid id PK
    uuid user_id FK
    bytea credential_id UK
  }
  devices {
    uuid id PK
    uuid user_id FK
    text state "pending, active, revoked"
  }
  device_keys {
    uuid id PK
    uuid device_id FK
    text purpose "dpop, step_up"
    text jkt UK
    timestamptz revoked_at
  }
  auth_sessions {
    uuid id PK
    uuid user_id FK
    uuid device_id FK
    uuid identity_id FK
    uuid parent_session_id FK "Erweiterungen"
    text client_component "app, console, notification_ext, share_ext, cli"
    text auth_method
    timestamptz step_up_at
    text step_up_method
    timestamptz revoked_at
  }
  refresh_token_families {
    uuid id PK
    uuid session_id FK
    text dpop_jkt
    integer current_generation
    timestamptz rotated_at
  }
  refresh_tokens {
    uuid id PK
    uuid family_id FK
    integer generation
    bytea token_hash UK
  }
  api_tokens {
    uuid id PK
    uuid principal_id FK
    bytea token_hash UK
    text[] scopes
  }
  local_credentials {
    uuid identity_id PK, FK
    text password_hash
    bytea totp_secret_ciphertext
    timestamptz locked_until
  }
  enrollment_codes {
    uuid id PK
    uuid user_id FK
    text purpose "first_login, identity_link, recovery"
    bytea code_hash UK
    uuid used_by_device_id FK
    timestamptz expires_at
  }
  auth_login_flows {
    uuid id PK
    uuid provider_id FK
    text mode "login, link"
    uuid user_id FK
    bytea oidc_state_hash UK
    bytea login_code_hash UK
    text status "started, code_issued, completed, failed"
    timestamptz expires_at
  }
  device_pairings {
    uuid id PK
    bytea pairing_code_hash UK
    text status "requested, approved, completed, rejected, expired"
    uuid user_id FK
    uuid approved_by_device_id FK
    uuid device_id FK
    timestamptz expires_at
  }
  files {
    uuid id PK
  }

  principals ||--o| users : "ist Mensch"
  files |o--o{ principals : "Avatar"
  users ||--o{ owners : "ist Owner"
  users ||--o{ user_identities : "hat"
  identity_providers ||--o{ user_identities : "liefert"
  users ||--o{ passkey_credentials : "hat"
  users ||--o{ devices : "hat"
  devices ||--o{ device_keys : "hat"
  users ||--o{ auth_sessions : "hat"
  devices ||--o{ auth_sessions : "trägt"
  user_identities |o--o{ auth_sessions : "meldet an"
  auth_sessions |o--o{ auth_sessions : "Kind-Sitzung"
  user_identities ||--o| local_credentials : "Passwort, TOTP"
  users ||--o{ enrollment_codes : "Code für"
  devices |o--o{ enrollment_codes : "eingelöst von"
  identity_providers ||--o{ auth_login_flows : "Anbieter"
  users |o--o{ auth_login_flows : "verknüpft"
  users |o--o{ device_pairings : "koppelt"
  devices |o--o{ device_pairings : "bestätigt, entsteht"
  auth_sessions ||--o{ refresh_token_families : "hat"
  refresh_token_families ||--o{ refresh_tokens : "rotiert"
  principals ||--o{ api_tokens : "besitzt"
