%% ERD Teil 3: Module agents und apps. Quelle: 03-datenmodell.md, 4.4, 4.5 (agent_sessions) und 4.11.
%% Reine Protokoll-Spalten (created_by, updated_by, granted_by, revoked_by und ähnliche) zeigen auf
%% principals(id) und sind nicht als Beziehung gezeichnet.
%% Tabellen anderer Module nur mit Schlüssel.
erDiagram
  agents {
    uuid principal_id PK, FK
    text adapter_kind
    text billing_mode "personal, organization"
    uuid credential_holder_id FK "Pflicht genau bei personal"
    text reported_billing_mode
    text reported_runtime_state
    bigint version
  }
  agent_consumer_cursors {
    uuid agent_id PK, FK
    text consumer_name PK
    bigint acked_seq
  }
  commands {
    uuid id PK
    uuid owner_principal_id FK "Agent oder App"
    text name
    text scope_kind "instance, space, channel"
    uuid scope_space_id FK
    uuid scope_channel_id FK
    boolean control
  }
  agent_sessions {
    uuid id PK
    uuid thread_id FK
    uuid agent_id FK
    text external_session_ref
    boolean is_current
    bigint version
  }
  apps {
    uuid principal_id PK, FK
    text slug UK
    jsonb manifest
    text manifest_version
  }
  app_installations {
    uuid id PK
    uuid app_id FK
    text[] granted_scopes
    text state "active, suspended, uninstalled"
  }
  webhook_subscriptions {
    uuid id PK
    uuid app_installation_id FK
    text signing_key_kid FK
    text state "active, paused, disabled"
    bigint last_delivered_seq
  }
  webhook_deliveries {
    uuid id PK
    uuid subscription_id FK
    bigint event_seq
    text status "pending, succeeded, failed, dead"
  }
  incoming_webhooks {
    uuid id PK
    uuid app_id FK
    uuid channel_id FK
    uuid thread_id FK
    bytea token_hash UK
  }
  principals {
    uuid id PK
  }
  users {
    uuid principal_id PK
  }
  spaces {
    uuid id PK
  }
  channels {
    uuid id PK
  }
  threads {
    uuid id PK
  }
  server_signing_keys {
    text kid PK
  }

  principals ||--o| agents : "ist Agent"
  users |o--o{ agents : "credential_holder"
  agents ||--o{ agent_consumer_cursors : "liest"
  principals ||--o{ commands : "registriert"
  spaces |o--o{ commands : "Geltung"
  channels |o--o{ commands : "Geltung"
  threads ||--o{ agent_sessions : "Sitzungen"
  agents ||--o{ agent_sessions : "führt"
  principals ||--o| apps : "ist App"
  apps ||--o{ app_installations : "installiert"
  app_installations ||--o{ webhook_subscriptions : "abonniert"
  server_signing_keys ||--o{ webhook_subscriptions : "signiert"
  webhook_subscriptions ||--o{ webhook_deliveries : "Versuche"
  apps ||--o{ incoming_webhooks : "schreibt als"
  channels ||--o{ incoming_webhooks : "Ziel"
  threads |o--o{ incoming_webhooks : "fester Thread"
