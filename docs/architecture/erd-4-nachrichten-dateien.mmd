%% ERD Teil 4: Module messaging und files. Quelle: 03-datenmodell.md, 4.6 und 4.7.
%% Reine Protokoll-Spalten (created_by, updated_by, granted_by, revoked_by und ähnliche) zeigen auf
%% principals(id) und sind nicht als Beziehung gezeichnet.
%% Tabellen anderer Module nur mit Schlüssel.
erDiagram
  direction LR
  messages {
    uuid id PK
    uuid thread_id FK
    uuid channel_id FK "Kopie für Rechtefilter"
    bigint thread_seq "UK mit thread_id"
    uuid author_principal_id FK
    uuid client_msg_id "UK mit author_principal_id"
    text origin "human, agent, app, import, system"
    text kind "text, voice, run, card, system"
    uuid reply_to_message_id FK
    uuid run_id FK
    text trigger_state "received, queued, working, done, failed, cancelled, followup_delivered"
    text trigger_state_reason
    uuid import_item_id FK
    bigint version
    timestamptz deleted_at
  }
  message_revisions {
    uuid id PK
    uuid message_id FK
    integer revision
  }
  mentions {
    uuid message_id PK, FK
    uuid principal_id PK, FK
    uuid thread_id FK
  }
  reactions {
    uuid message_id PK, FK
    uuid principal_id PK, FK
    text emoji PK
  }
  pins {
    uuid message_id PK, FK
    uuid thread_id FK
  }
  message_templates {
    uuid id PK
    uuid owner_user_id FK
    uuid channel_id FK
  }
  files {
    uuid id PK
    text object_key UK
    bytea sha256
    text purpose "attachment, avatar, branding, gdpr_export"
    uuid scope_channel_id FK "genau bei attachment"
    text upload_state "pending, complete, failed"
    text scan_status "pending, clean, infected, error, skipped"
    text transcript_status
  }
  file_upload_sessions {
    uuid file_id PK, FK
    text mode "direct, presigned"
    text state "open, completed, aborted, expired"
    timestamptz expires_at
  }
  file_upload_parts {
    uuid file_id PK, FK
    integer part_number PK
    bytea sha256
  }
  file_text_extracts {
    uuid file_id PK, FK
    text state "pending, done, failed, unsupported"
    tsvector search_vector
  }
  file_thumbnails {
    uuid file_id PK, FK
    text variant PK "small, medium, large, poster"
    text object_key UK
  }
  message_attachments {
    uuid message_id PK, FK
    smallint position PK
    uuid file_id FK, UK
  }
  principals {
    uuid id PK
  }
  users {
    uuid principal_id PK
  }
  threads {
    uuid id PK
  }
  channels {
    uuid id PK
  }
  runs {
    uuid id PK
  }
  import_items {
    uuid id PK
  }

