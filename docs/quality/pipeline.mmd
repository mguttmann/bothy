flowchart TB
  subgraph local["Local"]
    commit["git commit -s"] --> hooks["pre-commit: text rules, hygiene, ruff, gitleaks staged<br/>commit-msg: Conventional Commits, DCO"]
    hooks --> review
    review["independent review of the diff<br/>.review/&lt;sha&gt;.md with Urteil: JA"] --> push["git push"]
    push --> check["pre-push: review evidence, then make check<br/>= gates + denylist + sonar"]
  end
  subgraph ci["CI: ci.yml per pull request on main"]
    plan["plan: components from changed paths"] --> gates["gates: make gates"]
    plan --> deny["denylist: make denylist<br/>fork: generic rules only"]
    plan --> sonar["sonar: make sonar"]
    gates --> ok["ci-ok: the only required check"]
    deny --> ok
    sonar --> ok
  end
  subgraph runner["Runner"]
    hosted["GitHub-hosted, fixed label<br/>ubuntu-24.04; release also macos-15 and windows-2025"]
  end
  check --> plan
  ci -.-> runner
  ok --> merge["Squash and merge into main<br/>signed, linear"]
  merge --> denymain["denylist-main.yml: private list<br/>over the pushed commits"]
  merge --> tag["Release tag: release.yml<br/>gates, build, SBOM, provenance"]
