flowchart TB
    pg[("postgres 18")]
    files[("Objects: volume files or S3 bucket")]
    secrets[("Secrets bundle (age, offline with the owner)")]

    subgraph backupd["Service backup (bothy-backupd)"]
        repo1[("pgBackRest repo1 local: short retention")]
        dump["pg_dump -Fc daily"]
        objs["Object backup (restic or mirror)"]
        manifest["Manifest per run: counters, head_seq, audit head, checksums"]
        drill["Restore test: restore into backup-scratch, checks"]
    end

    repo2[("pgBackRest repo2 off-site: long retention, encrypted")]
    restic[("restic repository off-site: encrypted, append-only")]
    status["Metrics and table backup_runs: alert on age or error"]

    pg -- "archive-push per WAL segment (TLS)" --> repo1
    pg -- "archive-push" --> repo2
    pg -- "full and differential backup" --> repo1
    pg -- "full and differential backup" --> repo2
    pg --> dump --> restic
    files --> objs --> restic
    dump --> manifest
    objs --> manifest
    repo1 --> drill
    restic --> drill
    manifest --> drill
    drill --> status
    secrets -. "only for disaster recovery" .-> drill
