flowchart LR
    subgraph clients["Clients"]
        apps["Apps (iOS, Android, macOS, Windows)"]
        console["Web console"]
        adapters["Agent adapters"]
    end

    subgraph edge["Edge (exactly one)"]
        proxy["Reverse proxy with TLS on the host (profile direct)"]
        ts["tailscale sidecar with tailscale serve (profile tailscale)"]
    end

    subgraph host["Docker host"]
        subgraph net_default["Network default (with egress)"]
            api["api: bothy serve --role=api"]
            worker["worker: bothy serve --role=worker"]
            backup["backup: bothy-backupd + pgBackRest repository"]
            otel["otel-collector"]
            clamav["clamav (profile scan)"]
            obs["Prometheus, Alertmanager, Grafana (profile observability)"]
        end
        subgraph net_internal["Network internal (no egress)"]
            pg[("postgres 18 + pgBackRest")]
            s3[("seaweedfs (profile s3)")]
            lt["Loki, Tempo"]
        end
        vol_files[("Volume files")]
        vol_secrets[("Volume secrets, one subpath per service")]
    end

    offsite[("Off-site target of the backup")]
    saas["Telemetry backend (overlay)"]
    pushsvc["APNs, FCM"]

    apps --> proxy
    apps --> ts
    console --> proxy
    adapters --> proxy
    adapters --> ts
    proxy -- "127.0.0.1:BOTHY_HTTP_PUBLISH_PORT" --> api
    ts -- "127.0.0.1:8080 in the shared namespace" --> api
    api --> pg
    worker --> pg
    api --> vol_files
    worker --> vol_files
    worker --> clamav
    api --> s3
    worker --> s3
    worker --> pushsvc
    pg -- "WAL via pgBackRest TLS" --> backup
    backup --> offsite
    api -- OTLP --> otel
    worker -- OTLP --> otel
    backup -- OTLP --> otel
    otel --> obs
    otel --> lt
    otel --> saas
    vol_secrets -. "read only" .-> api
    vol_secrets -. "read only" .-> pg
