flowchart LR
    tag["Tag server/vX.Y.Z (signiert)"] --> gates["Lokale Gates = CI-Gates (Team H)"]
    gates --> build["Build je Architektur: linux/amd64, linux/arm64"]
    build --> manifest["Multi-Arch-Manifest bothy-server, bothy-postgres"]
    manifest --> sbom["SBOM: SPDX und CycloneDX (Syft)"]
    manifest --> sign["cosign keyless: Signatur je Digest"]
    manifest --> prov["Build-Provenance (actions/attest)"]
    sbom --> publish["ghcr.io: Images, Release mit Notes, Checksummen"]
    sign --> publish
    prov --> publish
    publish --> verify["Prüfung durch Betreiber: cosign verify, gh attestation verify"]

    apptag["Tag client/vX.Y.Z"] --> appgates["Gates und Tests der Apps"]
    appgates --> ios["iOS: TestFlight (intern, extern)"]
    appgates --> mac["macOS: Developer ID, Notarisierung, Sparkle-Appcast stable/beta"]
    appgates --> win["Windows: MSIX signiert, .appinstaller stable/beta"]
    appgates --> android["Android: interner Testkanal"]
