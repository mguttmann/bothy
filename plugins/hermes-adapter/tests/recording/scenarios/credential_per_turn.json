{
  "allowlist": [
    "alex"
  ],
  "config": {},
  "credentials": {
    "dotenv": {
      "anthropic_api_key": "api_key"
    }
  },
  "model_script": [
    {
      "paced": true,
      "text": [
        "The trip to the lake ",
        "is planned for ",
        "Saturday morning."
      ]
    },
    {
      "paced": true,
      "text": [
        "Later answer ",
        "for the next turn."
      ]
    }
  ],
  "point": "credential_type",
  "probe": {
    "supports_draft_streaming": true,
    "supports_status_text": true
  },
  "provider": "anthropic",
  "scenario": "credential_per_turn",
  "steps": [
    {
      "do": "credential_type"
    },
    {
      "do": "inject",
      "message": "m-1",
      "text": "ask",
      "thread": "t-1",
      "user": "alex"
    },
    {
      "do": "wait_for",
      "message": "m-1",
      "method": "on_processing_complete"
    },
    {
      "do": "wait_quiet"
    },
    {
      "do": "set_dotenv",
      "values": {
        "anthropic_oauth": "oauth"
      }
    },
    {
      "do": "credential_type"
    },
    {
      "do": "inject",
      "message": "m-2",
      "text": "second",
      "thread": "t-1",
      "user": "alex"
    },
    {
      "do": "wait_for",
      "message": "m-2",
      "method": "on_processing_complete"
    },
    {
      "do": "wait_quiet"
    }
  ],
  "texts": {
    "answer": "The trip to the lake is planned for Saturday morning.",
    "ask": "Please plan the trip to the lake.",
    "second": "Please confirm the time."
  }
}
