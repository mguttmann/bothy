{
  "allowlist": [
    "alex",
    "sam"
  ],
  "config": {
    "display": {
      "platforms": {
        "recording_probe": {
          "tool_progress": "off"
        }
      }
    }
  },
  "model_script": [
    {
      "hold": "first",
      "tool_calls": [
        {
          "arguments": {
            "todos": [
              {
                "content": "Book the boat",
                "id": "1",
                "status": "pending"
              }
            ]
          },
          "name": "todo_list"
        }
      ]
    },
    {
      "paced": true,
      "text": [
        "The trip to the lake ",
        "is planned for ",
        "Saturday morning."
      ]
    },
    {
      "paced": true,
      "text": [
        "Later answer ",
        "for the next turn."
      ]
    }
  ],
  "point": "interrupt_outcome",
  "probe": {
    "supports_draft_streaming": true,
    "supports_status_text": true
  },
  "provider": "openai",
  "scenario": "interrupt_command",
  "steps": [
    {
      "do": "inject",
      "message": "m-1",
      "text": "ask",
      "thread": "t-1",
      "user": "alex"
    },
    {
      "do": "wait_held",
      "latch": "first"
    },
    {
      "command": "/stop",
      "do": "interrupt",
      "message": "m-2",
      "thread": "t-1",
      "user": "alex",
      "way": "command"
    },
    {
      "do": "wait_for",
      "from_start": true,
      "message": "m-1",
      "method": "on_processing_complete"
    },
    {
      "do": "wait_quiet"
    },
    {
      "do": "release",
      "latch": "first"
    },
    {
      "do": "wait_for",
      "from_start": true,
      "method": "hook:on_session_end"
    },
    {
      "do": "wait_quiet"
    }
  ],
  "texts": {
    "answer": "The trip to the lake is planned for Saturday morning.",
    "ask": "Please plan the trip to the lake."
  }
}
