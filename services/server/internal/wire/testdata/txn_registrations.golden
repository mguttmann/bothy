# txn registrations; regenerate with: go test ./internal/wire -run TestTxnRegistrationsGolden -update
hook rights_begin authz github.com/OWNER/bothy/services/server/internal/authz/app.(*RightsHook).Begin-fm
hook rights_check authz github.com/OWNER/bothy/services/server/internal/authz/app.(*RightsHook).BeforeCommit-fm
hook sync sync github.com/OWNER/bothy/services/server/internal/sync/app.(*PhaseHook).Run-fm
hook audit audit github.com/OWNER/bothy/services/server/internal/audit/app.(*Chain).Hook-fm
