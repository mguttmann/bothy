# Channel endpoint of the PTY helper of {{.Name}}. Generated by bothy-host install.
# systemd creates the socket, so no process of the session user can create it first.
[Unit]
Description=bothy-host PTY helper channel of {{.Name}}

[Socket]
ListenStream={{.Endpoint}}
SocketUser=root
SocketGroup={{.ServiceUser}}
SocketMode=0660
DirectoryMode=0755
Accept=no

[Install]
WantedBy=sockets.target
