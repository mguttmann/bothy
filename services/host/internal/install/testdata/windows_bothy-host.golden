# Windows service bothy-host. Generated by bothy-host install; the executor applies it through the
# service control manager. Failure actions restart a crash; FailureActionsOnNonCrashFailures is
# false, so a stop with ERROR_SERVICE_SPECIFIC_ERROR and code 78 is not restarted.
name=bothy-host
display=bothy-host service
binary="C:\Program Files\bothy-host\bothy-host.exe" run --config "C:\Program Files\bothy-host\config.yaml"
account=NT SERVICE\bothy-host
start=auto
failure_actions=restart/5000,restart/5000,restart/5000
failure_reset=86400
failure_actions_on_non_crash_failures=false
sddl=D:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCDCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWLORC;;;AU)
