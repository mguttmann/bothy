<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Host service bothy-host in the owner account mode (ADR 0073), written by bothy-host install
     --owner-account as a LaunchAgent of the account itself, without administrator rights.
     KeepAlive restarts only a crash; an exit with a code, 78 included, stays. ProcessType Adaptive, not
     Background: a Background job is always throttled, and the checks before every new session
     then outlast the opening window on a loaded host. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>bothy-host</string>
	<key>ProgramArguments</key>
	<array>
		<string>/<Users>/alex/Library/Application Support/bothy-host/bin/bothy-host</string>
		<string>run</string>
		<string>--config</string>
		<string>/<Users>/alex/Library/Application Support/bothy-host/config.yaml</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>Crashed</key>
		<true/>
	</dict>
	<key>ProcessType</key>
	<string>Adaptive</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>GOTRACEBACK</key>
		<string>crash</string>
	</dict>
	<key>Umask</key>
	<integer>63</integer>
</dict>
</plist>
