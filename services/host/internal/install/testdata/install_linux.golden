run /usr/sbin/useradd --system --user-group --home-dir /var/lib/bothy-host --no-create-home --shell /usr/sbin/nologin bothy-host
mkdir /var/lib/bothy-host 0700 bothy-host
mkdir /opt/bothy-host/bin 0755 root
copy /tmp/download/bothy-host -> /opt/bothy-host/bin/bothy-host 0755 root
mkdir /etc/bothy-host 0755 root
write /etc/bothy-host/config.yaml 0644 root (134 bytes)
run /usr/sbin/useradd --create-home --user-group --shell /bin/bash bothy-s-alex
chmod ~bothy-s-alex 0700 bothy-s-alex
write /etc/systemd/system/bothy-host-helper-bothy-s-alex.socket 0644 root (420 bytes)
write /etc/systemd/system/bothy-host-helper-bothy-s-alex.service 0644 root (714 bytes)
chmod ~bothy-s-sam 0700 bothy-s-sam
write /etc/systemd/system/bothy-host-helper-bothy-s-sam.socket 0644 root (417 bytes)
write /etc/systemd/system/bothy-host-helper-bothy-s-sam.service 0644 root (709 bytes)
write /etc/systemd/system/bothy-host.service 0644 root (1078 bytes)
run /usr/bin/systemctl daemon-reload
run /usr/bin/systemctl enable --now bothy-host-helper-bothy-s-alex.socket
run /usr/bin/systemctl enable --now bothy-host-helper-bothy-s-sam.socket
run /usr/bin/systemctl enable bothy-host.service
run /usr/bin/systemctl restart bothy-host.service
