<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- PTY helper of bothy-s-alex. Generated by bothy-host install. launchd creates the socket and
     passes the listening socket on standard input (inetdCompatibility, Wait = true). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>bothy-host.helper.bothy-s-alex</string>
	<key>UserName</key>
	<string>bothy-s-alex</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Application Support/bothy-host/bin/bothy-host</string>
		<string>pty-helper</string>
		<string>--session-user</string>
		<string>bothy-s-alex</string>
	</array>
	<key>Sockets</key>
	<dict>
		<key>Listener</key>
		<dict>
			<key>SockPathName</key>
			<string>/Library/Application Support/bothy-host/run/helper-bothy-s-alex.sock</string>
			<key>SockPathMode</key>
			<integer>432</integer>
			<key>SockPathOwner</key>
			<integer>0</integer>
			<key>SockPathGroup</key>
			<integer>400</integer>
		</dict>
	</dict>
	<key>inetdCompatibility</key>
	<dict>
		<key>Wait</key>
		<true/>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>Crashed</key>
		<true/>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>GOTRACEBACK</key>
		<string>crash</string>
	</dict>
	<key>Umask</key>
	<integer>63</integer>
</dict>
</plist>
