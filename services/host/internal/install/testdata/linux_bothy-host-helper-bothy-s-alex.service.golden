# PTY helper of bothy-s-alex. Generated by bothy-host install.
# No NoNewPrivileges= and no option that implies it (HD3 must see a sudo rule of the session user).
[Unit]
Description=bothy-host PTY helper of bothy-s-alex
Requires=bothy-host-helper-bothy-s-alex.socket

[Service]
Type=simple
User=bothy-s-alex
ExecStart=/opt/bothy-host/bin/bothy-host pty-helper --session-user bothy-s-alex
Restart=on-failure
UMask=0077
# Delegate=yes hands the cgroup subtree of this unit to the helper: it moves itself into the leaf
# helper and creates one cgroup s-<session id> per session, which it ends with cgroup.kill
# (M2-45, docs/spec/24-terminal.md 6.5). systemd kills the whole subtree when the unit stops.
Delegate=yes
