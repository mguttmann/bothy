# Host service bothy-host (docs/spec/24-terminal.md 2.2). Generated by bothy-host install.
# A refused start exits 78 (EX_CONFIG): RestartPreventExitStatus keeps systemd from restarting
# it; only "bothy-host restart" starts it again. No NoNewPrivileges= and no option that implies
# it, because under no_new_privs every "sudo -n true" fails and would hide a sudo rule from HD3.
[Unit]
Description=bothy-host service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bothy-host
Group=bothy-host
ExecStart=/opt/bothy-host/bin/bothy-host run --config /etc/bothy-host/config.yaml
Restart=on-failure
RestartPreventExitStatus=78
UMask=0077

[Install]
WantedBy=multi-user.target
