# Channel endpoint of the PTY helper of bothy-s-alex. Generated by bothy-host install.
# systemd creates the socket, so no process of the session user can create it first.
[Unit]
Description=bothy-host PTY helper channel of bothy-s-alex

[Socket]
ListenStream=/run/bothy-host/helper-bothy-s-alex.sock
SocketUser=root
SocketGroup=bothy-host
SocketMode=0660
DirectoryMode=0755
Accept=no

[Install]
WantedBy=sockets.target
