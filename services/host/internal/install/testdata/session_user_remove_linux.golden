config.remove /etc/bothy-host/config.yaml bothy-s-sam
run /usr/bin/systemctl disable --now bothy-host-helper-bothy-s-sam.socket bothy-host-helper-bothy-s-sam.service
remove /etc/systemd/system/bothy-host-helper-bothy-s-sam.socket
remove /etc/systemd/system/bothy-host-helper-bothy-s-sam.service
run /usr/bin/systemctl daemon-reload
chmod ~bothy-s-sam 0700 bothy-s-sam
run /usr/bin/systemctl reset-failed bothy-host.service
run /usr/bin/systemctl restart bothy-host.service
