{
  "$description": "Fonts and type roles. Sizes in px; the apps scale them with the system setting (dynamic font size).",
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Atkinson Hyperlegible Next", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"],
        "$description": "Interface and messages. OFL-1.1, variable (wght 200 to 800). Rationale in docs/design/typography.md."
      },
      "mono": {
        "$value": ["Atkinson Hyperlegible Mono", "ui-monospace", "SF Mono", "Cascadia Mono", "Consolas", "monospace"],
        "$description": "Code, tool names, IDs. OFL-1.1, variable (wght 200 to 800)."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {"$value": 400},
      "medium": {"$value": 500},
      "semibold": {"$value": 600},
      "bold": {"$value": 700},
      "extrabold": {"$value": 800}
    },
    "size": {
      "$type": "dimension",
      "12": {"$value": {"value": 12, "unit": "px"}},
      "13": {"$value": {"value": 13, "unit": "px"}},
      "14": {"$value": {"value": 14, "unit": "px"}},
      "15": {"$value": {"value": 15, "unit": "px"}},
      "16": {"$value": {"value": 16, "unit": "px"}},
      "18": {"$value": {"value": 18, "unit": "px"}},
      "20": {"$value": {"value": 20, "unit": "px"}},
      "24": {"$value": {"value": 24, "unit": "px"}},
      "30": {"$value": {"value": 30, "unit": "px"}}
    },
    "tracking": {
      "$type": "dimension",
      "tight": {"$value": {"value": -0.4, "unit": "px"}},
      "snug": {"$value": {"value": -0.15, "unit": "px"}},
      "normal": {"$value": {"value": 0, "unit": "px"}},
      "wide": {"$value": {"value": 0.3, "unit": "px"}}
    }
  },
  "type": {
    "$type": "typography",
    "$description": "Type roles. Components use only these roles, never font.size directly.",
    "display": {
      "$value": {"fontFamily": "{font.family.sans}", "fontSize": "{font.size.30}", "fontWeight": "{font.weight.extrabold}", "letterSpacing": "{font.tracking.tight}", "lineHeight": 1.2},
      "$description": "Empty states, setup, metric tiles of the statistics."
    },
    "title": {
      "$value": {"fontFamily": "{font.family.sans}", "fontSize": "{font.size.20}", "fontWeight": "{font.weight.bold}", "letterSpacing": "{font.tracking.snug}", "lineHeight": 1.3},
      "$description": "Title of a view, dialog title, thread title in the header."
    },
    "heading": {
      "$value": {"fontFamily": "{font.family.sans}", "fontSize": "{font.size.16}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.tracking.normal}", "lineHeight": 1.375},
      "$description": "Channel header, sections in settings and console."
    },
    "body": {
      "$value": {"fontFamily": "{font.family.sans}", "fontSize": "{font.size.15}", "fontWeight": "{font.weight.regular}", "letterSpacing": "{font.tracking.normal}", "lineHeight": 1.467},
      "$description": "Message text (desktop). On touch devices, density.message.font-size applies."
    },
    "body-strong": {
      "$value": {"fontFamily": "{font.family.sans}", "fontSize": "{font.size.15}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.tracking.normal}", "lineHeight": 1.467},
      "$description": "Author name, emphasis in text."
    },
    "body-sm": {
      "$value": {"fontFamily": "{font.family.sans}", "fontSize": "{font.size.14}", "fontWeight": "{font.weight.regular}", "letterSpacing": "{font.tracking.normal}", "lineHeight": 1.43},
      "$description": "List rows, channel names, live box content."
    },
    "label": {
      "$value": {"fontFamily": "{font.family.sans}", "fontSize": "{font.size.13}", "fontWeight": "{font.weight.semibold}", "letterSpacing": "{font.tracking.normal}", "lineHeight": 1.385},
      "$description": "Buttons, chips, badges, column headers."
    },
    "section": {
      "$value": {"fontFamily": "{font.family.sans}", "fontSize": "{font.size.12}", "fontWeight": "{font.weight.bold}", "letterSpacing": "{font.tracking.wide}", "lineHeight": 1.333},
      "$description": "Space titles in the sidebar, group headings. No uppercase by text transform (long German words)."
    },
    "caption": {
      "$value": {"fontFamily": "{font.family.sans}", "fontSize": "{font.size.12}", "fontWeight": "{font.weight.regular}", "letterSpacing": "{font.tracking.normal}", "lineHeight": 1.333},
      "$description": "Timestamps, metrics, help texts."
    },
    "code": {
      "$value": {"fontFamily": "{font.family.mono}", "fontSize": "{font.size.14}", "fontWeight": "{font.weight.regular}", "letterSpacing": "{font.tracking.normal}", "lineHeight": 1.43},
      "$description": "Code blocks and inline code."
    },
    "code-sm": {
      "$value": {"fontFamily": "{font.family.mono}", "fontSize": "{font.size.12}", "fontWeight": "{font.weight.medium}", "letterSpacing": "{font.tracking.normal}", "lineHeight": 1.333},
      "$description": "Tool chips, IDs, costs and token counts in the live box."
    }
  }
}
