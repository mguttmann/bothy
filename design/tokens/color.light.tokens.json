{
  "$description": "Semantic color roles, theme light. Same keys as in the other theme; only references to palette.*, except for the translucent roles scrim and shadow.",
  "color": {
    "$type": "color",
    "surface": {
      "$description": "Surfaces in layers. The sidebar is a brand surface in both themes.",
      "sidebar": {"$value": "{palette.spruce.900}", "$description": "Column with spaces and channels (brand surface)."},
      "sidebar-hover": {"$value": "{palette.spruce.850}", "$description": "Row under the pointer in the sidebar."},
      "sidebar-selected": {"$value": "{palette.spruce.800}", "$description": "Selected channel in the sidebar."},
      "list": {"$value": "{palette.granite.50}", "$description": "Post list and right session column."},
      "canvas": {"$value": "{palette.granite.0}", "$description": "History, main surface."},
      "raised": {"$value": "{palette.granite.25}", "$description": "Live box, cards, component groups."},
      "overlay": {"$value": "{palette.granite.0}", "$description": "Menus, dialogs, quick switcher, suggestion list."},
      "hover": {"$value": "{palette.granite.100}", "$description": "Row under the pointer in the list and the history."},
      "selected": {"$value": "{palette.spruce.100}", "$description": "Selected row in the list and the suggestion list."},
      "input": {"$value": "{palette.granite.25}", "$description": "Input field and form fields."},
      "sunken": {"$value": "{palette.granite.100}", "$description": "Code blocks, quotes, collapsed live box."}
    },
    "text": {
      "$description": "Text colors. Every pairing with a surface is listed in design/design-rules.json.",
      "primary": {"$value": "{palette.granite.950}", "$description": "Body text, titles."},
      "secondary": {"$value": "{palette.granite.700}", "$description": "Metadata, timestamps, labels."},
      "muted": {"$value": "{palette.granite.600}", "$description": "Placeholders, hints, Done section."},
      "link": {"$value": "{palette.spruce.700}", "$description": "Links and mention pills."},
      "on-accent": {"$value": "{palette.granite.0}", "$description": "Text on accent buttons."},
      "on-sidebar": {"$value": "{palette.spruce.50}", "$description": "Unread channel name, space title."},
      "on-sidebar-secondary": {"$value": "{palette.spruce.200}", "$description": "Read channel name."},
      "on-sidebar-muted": {"$value": "{palette.spruce.300}", "$description": "Muted channels, counter label."}
    },
    "border": {
      "$description": "Lines. subtle and default are decoration; control carries meaning (WCAG 1.4.11).",
      "subtle": {"$value": "{palette.granite.150}", "$description": "Dividers between rows."},
      "default": {"$value": "{palette.granite.200}", "$description": "Column borders, cards."},
      "control": {"$value": "{palette.granite.500}", "$description": "Border of input fields and secondary buttons."},
      "on-sidebar": {"$value": "{palette.spruce.800}", "$description": "Dividers in the sidebar."}
    },
    "focus": {
      "$description": "Focus ring. Always visible, never color alone: in addition, two pixels wide.",
      "ring": {"$value": "{palette.spruce.600}", "$description": "Focus on all content surfaces."},
      "ring-on-sidebar": {"$value": "{palette.gorse.300}", "$description": "Focus in the sidebar."}
    },
    "accent": {
      "$description": "Brand accent: primary action, selection, running agent.",
      "bg": {"$value": "{palette.spruce.700}", "$description": "Primary button."},
      "bg-hover": {"$value": "{palette.spruce.800}", "$description": "Primary button under the pointer."},
      "bg-pressed": {"$value": "{palette.spruce.900}", "$description": "Primary button, pressed."},
      "fg": {"$value": "{palette.spruce.700}", "$description": "Accent as text or icon."},
      "subtle": {"$value": "{palette.spruce.50}", "$description": "Tinted background of own message actions, info chips."}
    },
    "attention": {
      "$description": "Gorse: mentions and everything that waits for a person (waiting_input, approval).",
      "fg": {"$value": "{palette.gorse.700}", "$description": "Text and icon."},
      "subtle": {"$value": "{palette.gorse.50}", "$description": "Tinted background of a message with a mention."},
      "border": {"$value": "{palette.gorse.600}", "$description": "Bar on the left of mentions and waiting runs."},
      "bg": {"$value": "{palette.gorse.200}", "$description": "Strong badge 'Waiting for you'."},
      "on-bg": {"$value": "{palette.gorse.950}", "$description": "Text on attention.bg."}
    },
    "success": {
      "$description": "Moss: done, passed.",
      "fg": {"$value": "{palette.moss.700}"},
      "subtle": {"$value": "{palette.moss.50}"},
      "border": {"$value": "{palette.moss.600}"},
      "bg": {"$value": "{palette.moss.700}"},
      "on-bg": {"$value": "{palette.granite.0}"}
    },
    "warning": {
      "$description": "Amber: stall, degraded, estimate exceeded.",
      "fg": {"$value": "{palette.amber.800}"},
      "subtle": {"$value": "{palette.amber.100}", "$description": "amber.100 instead of amber.50: as a surface, amber.50 looks like cream (guard in design/design-rules.json)."},
      "border": {"$value": "{palette.amber.600}"},
      "bg": {"$value": "{palette.amber.300}"},
      "on-bg": {"$value": "{palette.amber.950}"}
    },
    "danger": {
      "$description": "Rowan: errors, destructive actions.",
      "fg": {"$value": "{palette.rowan.900}"},
      "subtle": {"$value": "{palette.rowan.50}"},
      "border": {"$value": "{palette.rowan.600}"},
      "bg": {"$value": "{palette.rowan.700}"},
      "on-bg": {"$value": "{palette.granite.0}"}
    },
    "info": {
      "$description": "Loch: notes, delivered follow-ups.",
      "fg": {"$value": "{palette.loch.700}"},
      "subtle": {"$value": "{palette.loch.50}"},
      "border": {"$value": "{palette.loch.600}"},
      "bg": {"$value": "{palette.loch.700}"},
      "on-bg": {"$value": "{palette.granite.0}"}
    },
    "run": {
      "$description": "States of a run (runs.state): color of the live box spine and of the state icon.",
      "queued": {"$value": "{palette.granite.500}", "$description": "queued"},
      "running": {"$value": "{palette.spruce.600}", "$description": "running"},
      "waiting": {"$value": "{palette.gorse.600}", "$description": "waiting_input"},
      "completed": {"$value": "{palette.moss.600}", "$description": "completed"},
      "failed": {"$value": "{palette.rowan.600}", "$description": "failed"},
      "cancelled": {"$value": "{palette.granite.600}", "$description": "cancelled"}
    },
    "trigger": {
      "$description": "Trigger state (messages.trigger_state) as an icon color. Replaces the status emoji.",
      "received": {"$value": "{palette.granite.500}", "$description": "received"},
      "queued": {"$value": "{palette.granite.600}", "$description": "queued"},
      "working": {"$value": "{palette.spruce.600}", "$description": "working"},
      "done": {"$value": "{palette.moss.600}", "$description": "done"},
      "failed": {"$value": "{palette.rowan.600}", "$description": "failed"},
      "followup": {"$value": "{palette.loch.600}", "$description": "followup_delivered"}
    },
    "badge": {
      "$description": "Backend policy badge (billing_mode) in the thread header and on the agent card.",
      "personal-bg": {"$value": "{palette.heather.100}", "$description": "Personal"},
      "personal-fg": {"$value": "{palette.heather.800}", "$description": "Personal"},
      "organization-bg": {"$value": "{palette.loch.100}", "$description": "Organization"},
      "organization-fg": {"$value": "{palette.loch.800}", "$description": "Organization"}
    },
    "code": {
      "$description": "Code in messages and tool details.",
      "fg": {"$value": "{palette.granite.900}"},
      "bg": {"$value": "{palette.granite.100}"}
    },
    "terminal": {
      "$description": "Terminal view (components.md, section 12): surface, text, cursor, selection and the 16 ANSI colors. Pairings in design-rules.json.",
      "bg": {"$value": "{palette.granite.25}", "$description": "Surface of the terminal."},
      "fg": {"$value": "{palette.granite.900}", "$description": "Default text (SGR 39)."},
      "cursor": {"$value": "{palette.spruce.700}", "$description": "Block and bar cursor."},
      "cursor-text": {"$value": "{palette.granite.25}", "$description": "Character under the block cursor."},
      "selection-bg": {"$value": "{palette.spruce.100}", "$description": "Background of selected text; text on it in terminal.fg."},
      "ansi": {
        "$description": "ANSI colors 0 to 7 (SGR 30 to 37) and 8 to 15 (bright, SGR 90 to 97). The gray tones 0, 7 and 15 are the ends toward the surface and need only 3:1; all others are text with 4.5:1.",
        "black": {"$value": "{palette.granite.900}", "$description": "0"},
        "red": {"$value": "{palette.rowan.800}", "$description": "1"},
        "green": {"$value": "{palette.moss.800}", "$description": "2"},
        "yellow": {"$value": "{palette.gorse.800}", "$description": "3"},
        "blue": {"$value": "{palette.loch.800}", "$description": "4"},
        "magenta": {"$value": "{palette.heather.800}", "$description": "5"},
        "cyan": {"$value": "{palette.spruce.800}", "$description": "6"},
        "white": {"$value": "{palette.granite.600}", "$description": "7"},
        "bright-black": {"$value": "{palette.granite.700}", "$description": "8"},
        "bright-red": {"$value": "{palette.rowan.700}", "$description": "9"},
        "bright-green": {"$value": "{palette.moss.700}", "$description": "10"},
        "bright-yellow": {"$value": "{palette.gorse.700}", "$description": "11"},
        "bright-blue": {"$value": "{palette.loch.700}", "$description": "12"},
        "bright-magenta": {"$value": "{palette.heather.700}", "$description": "13"},
        "bright-cyan": {"$value": "{palette.spruce.700}", "$description": "14"},
        "bright-white": {"$value": "{palette.granite.500}", "$description": "15"}
      }
    },
    "viz": {
      "$description": "Charts in bothy_viz and in the Grafana panel (components.md, section 11; 25-visualization.md, section 10).",
      "series": {
        "$description": "Categorical series in a fixed order; blue and orange first, because they stay distinguishable with red-green color blindness. A second cue (label or pattern) is required.",
        "1": {"$value": "{palette.loch.600}"},
        "2": {"$value": "{palette.amber.600}"},
        "3": {"$value": "{palette.spruce.700}"},
        "4": {"$value": "{palette.heather.600}"},
        "5": {"$value": "{palette.gorse.600}"},
        "6": {"$value": "{palette.moss.900}"},
        "7": {"$value": "{palette.rowan.600}"},
        "8": {"$value": "{palette.granite.500}"}
      },
      "axis": {"$value": "{palette.granite.500}", "$description": "Axis lines and tick marks; labels in color.text.secondary."},
      "grid": {"$value": "{palette.granite.150}", "$description": "Grid lines and the line between lanes; purely structural, no contrast requirement."},
      "area-fill": {"$value": "{palette.spruce.100}", "$description": "Fill under a line; the line carries the information, the fill does not."}
    },
    "category": {
      "$description": "Category colors for spaces (spaces.color) and forum tags (forum_tags.color). The stored value is the key, for example 'heather'.",
      "spruce": {
        "on-sidebar": {"$value": "{palette.spruce.300}", "$description": "Icon of the space in the sidebar."},
        "fg": {"$value": "{palette.spruce.700}", "$description": "Icon and dot on content surfaces."},
        "chip-bg": {"$value": "{palette.spruce.100}", "$description": "Tag chip."},
        "chip-fg": {"$value": "{palette.spruce.800}", "$description": "Text on the tag chip."}
      },
      "loch": {
        "on-sidebar": {"$value": "{palette.loch.300}", "$description": "Icon of the space in the sidebar."},
        "fg": {"$value": "{palette.loch.700}", "$description": "Icon and dot on content surfaces."},
        "chip-bg": {"$value": "{palette.loch.100}", "$description": "Tag chip."},
        "chip-fg": {"$value": "{palette.loch.800}", "$description": "Text on the tag chip."}
      },
      "heather": {
        "on-sidebar": {"$value": "{palette.heather.300}", "$description": "Icon of the space in the sidebar."},
        "fg": {"$value": "{palette.heather.700}", "$description": "Icon and dot on content surfaces."},
        "chip-bg": {"$value": "{palette.heather.100}", "$description": "Tag chip."},
        "chip-fg": {"$value": "{palette.heather.800}", "$description": "Text on the tag chip."}
      },
      "rowan": {
        "on-sidebar": {"$value": "{palette.rowan.300}", "$description": "Icon of the space in the sidebar."},
        "fg": {"$value": "{palette.rowan.700}", "$description": "Icon and dot on content surfaces."},
        "chip-bg": {"$value": "{palette.rowan.100}", "$description": "Tag chip."},
        "chip-fg": {"$value": "{palette.rowan.800}", "$description": "Text on the tag chip."}
      },
      "amber": {
        "on-sidebar": {"$value": "{palette.amber.300}", "$description": "Icon of the space in the sidebar."},
        "fg": {"$value": "{palette.amber.700}", "$description": "Icon and dot on content surfaces."},
        "chip-bg": {"$value": "{palette.amber.100}", "$description": "Tag chip."},
        "chip-fg": {"$value": "{palette.amber.800}", "$description": "Text on the tag chip."}
      },
      "gorse": {
        "on-sidebar": {"$value": "{palette.gorse.300}", "$description": "Icon of the space in the sidebar."},
        "fg": {"$value": "{palette.gorse.700}", "$description": "Icon and dot on content surfaces."},
        "chip-bg": {"$value": "{palette.gorse.100}", "$description": "Tag chip."},
        "chip-fg": {"$value": "{palette.gorse.800}", "$description": "Text on the tag chip."}
      },
      "moss": {
        "on-sidebar": {"$value": "{palette.moss.300}", "$description": "Icon of the space in the sidebar."},
        "fg": {"$value": "{palette.moss.700}", "$description": "Icon and dot on content surfaces."},
        "chip-bg": {"$value": "{palette.moss.100}", "$description": "Tag chip."},
        "chip-fg": {"$value": "{palette.moss.800}", "$description": "Text on the tag chip."}
      },
      "granite": {
        "on-sidebar": {"$value": "{palette.granite.200}", "$description": "Icon of the space in the sidebar."},
        "fg": {"$value": "{palette.granite.700}", "$description": "Icon and dot on content surfaces."},
        "chip-bg": {"$value": "{palette.granite.100}", "$description": "Tag chip."},
        "chip-fg": {"$value": "{palette.granite.800}", "$description": "Text on the tag chip."}
      }
    },
    "scrim": {
      "$value": {
        "colorSpace": "oklch",
        "components": [0.178, 0.021, 210],
        "alpha": 0.48
      },
      "$description": "Dimming behind dialogs. Translucent, so never in contrast pairs."
    },
    "shadow": {
      "$value": {
        "colorSpace": "oklch",
        "components": [0.2, 0.023, 210],
        "alpha": 0.16
      },
      "$description": "Shadow color for elevation.*."
    }
  }
