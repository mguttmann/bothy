      "move-slow": {"$value": {"value": 260, "unit": "ms"}, "$description": "Navigationsstapel auf Mobilgeräten (Plattformübergang hat Vorrang)."},
      "fade": {"$value": {"value": 120, "unit": "ms"}, "$description": "Ein- und Ausblenden ohne Bewegung."},
      "pulse": {"$value": {"value": 1400, "unit": "ms"}, "$description": "Periode des Lauf-Indikators (running, working). 0 heißt: kein Puls, statisches Icon."}
