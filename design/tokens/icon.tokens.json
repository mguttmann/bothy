          "action.stop": {"name": "stop-circle", "weight": "fill"},
          "action.attach": {"name": "paperclip", "weight": "regular"},
          "action.voice": {"name": "microphone", "weight": "regular"},
          "action.send": {"name": "paper-plane-right", "weight": "fill"},
          "action.close-thread": {"name": "seal-check", "weight": "regular"},
