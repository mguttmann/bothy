{
  "$description": "Icons: Größen als Tokens, die Zuordnung semantischer Namen zu Phosphor-Glyphen als Erweiterung (DTCG kennt keinen Icon-Typ). Namensraum 'ds' bis Produktname und Domain feststehen (ADR 0044).",
  "icon": {
    "size": {
      "$type": "dimension",
      "sm": {"$value": {"value": 16, "unit": "px"}, "$description": "In Listenzeilen, Chips, Auslöser-Status."},
      "md": {"$value": {"value": 20, "unit": "px"}, "$description": "Standard in Knöpfen und Kopfzeilen."},
      "lg": {"$value": {"value": 24, "unit": "px"}, "$description": "Mobile Navigation, leere Zustände."}
    },
    "$extensions": {
      "ds.icons": {
        "set": "phosphor",
        "source": "@phosphor-icons/core",
        "version": "2.1.1",
        "license": "MIT",
        "weights": {"default": "regular", "active": "fill", "small": "bold"},
        "glyphs": {
          "trigger.received": {"name": "check", "weight": "regular"},
          "trigger.queued": {"name": "hourglass-medium", "weight": "regular"},
          "trigger.working": {"name": "circle-notch", "weight": "bold", "motion": "spin"},
          "trigger.done": {"name": "check-circle", "weight": "fill"},
          "trigger.failed": {"name": "x-circle", "weight": "fill"},
          "trigger.followup": {"name": "arrow-bend-down-right", "weight": "regular"},
